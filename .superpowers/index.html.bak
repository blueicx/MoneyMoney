// --- Macro Indicators ---
async function loadMacroIndicators() {
  const el = document.getElementById('macro-indicators');
  if (!el) return;
  el.innerHTML = Array(4).fill('<div class="skl skl-card"><div class="skl-line"></div><div class="skl-line w60"></div></div>').join('');
  
  const cards = [];
  
  // FX rates
  try {
    const fxRes = await fetch('/api/macro/fx');
    const fxD = await fxRes.json();
    if (fxD.success) {
      cards.push({ name: 'USD/CNY', value: fxD.data.CNY.toFixed(4), icon: 'U{1F4B1}' });
      cards.push({ name: 'USD/EUR', value: fxD.data.EUR.toFixed(4), icon: 'U{1F4B6}' });
    }
  } catch(e) {}
  
  // Gold price
  try {
    const goldRes = await fetch('/api/macro/gold');
    const goldD = await goldRes.json();
    if (goldD.success && goldD.data.price > 0) {
      cards.push({ name: '黄金 (美盎)', value: '$' + goldD.data.price.toFixed(0), icon: 'U{1F947}' });
    }
  } catch(e) {}
  
  // Stablecoins
  try {
    const scRes = await fetch('/api/macro/stablecoins');
    const scD = await scRes.json();
    if (scD.success && scD.data.total > 0) {
      const total = scD.data.total;
      const display = total >= 1e9 ? '$' + (total/1e9).toFixed(0) + 'B' : '$' + (total/1e6).toFixed(0) + 'M';
      cards.push({ name: '稳定币市值', value: display, icon: 'U{1F4A0}' });
    }
  } catch(e) {}
  // Commodities (gold/silver/oil via Sina)
  try {
    const comRes = await fetch('/api/macro/commodities');
    const comD = await comRes.json();
    if (comD.success && comD.data) {
      if (comD.data.silver > 0) cards.push({ name: 'Silver', value: '$' + comD.data.silver.toFixed(2) });
      if (comD.data.crudeOil > 0) cards.push({ name: 'Crude Oil', value: '$' + comD.data.crudeOil.toFixed(2) });
      if (comD.data.naturalGas > 0) cards.push({ name: 'Nat Gas', value: '$' + comD.data.naturalGas.toFixed(3) });
    }
  } catch(e) {}

  // BTC on-chain (mempool.space)
  try {
    const btcRes = await fetch('/api/macro/btc-chain');
    const btcD = await btcRes.json();
    if (btcD.success && btcD.data.blockHeight > 0) {
      cards.push({ name: 'BTC Block', value: '#' + btcD.data.blockHeight.toLocaleString() });
      const dpct = btcD.data.difficultyChangePct;
      if (dpct !== undefined) {
        cards.push({ name: 'Difficulty Change', value: (dpct >= 0 ? '+' : '') + dpct.toFixed(1) + '%' });
      }
    }
  } catch(e) {}
  
  el.innerHTML = cards.map(c =>
    '<div class="idx-card"><div class="idx-name">' + c.name + '</div>' +
    '<div class="idx-price">' + c.value + '</div></div>'
  ).join('') || '';
}


