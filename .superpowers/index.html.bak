  <script>function translateStrategyName(name){
  const key=String(name||"").toLowerCase();
  if(key.includes("momentum"))return "动量策略";
  if(key.includes("mean reversion"))return "均值回归策略";
  if(key.includes("order imbalance"))return "订单失衡策略";
  if(key.includes("sentiment"))return "AI 情绪策略";
  return name;
}

function translateAction(action) {if (!action) return "";const value = String(action).toUpperCase();if (value.includes("BUY")) return "买入";if (value.includes("SELL")) return "卖出";if (value === "HOLD") return "观望";return action;}

let categoriesData = [];
let categoryStatsCache = {};
let orderbooksCache = {};
let categoryOddsCache = {};
let selectedCategory = null;
let selectedMarket = null;
let showConditions = false;
let tradeState = { side: 'yes', orderType: 'LIMIT' };

// --- Analysis Tab ---
async function loadAnalysis() {
  const loading = document.getElementById('analysis-loading');
  const content = document.getElementById('analysis-content');
  const errDiv = document.getElementById('analysis-error');
  const btn = document.getElementById('analysis-refresh-btn');
  const timeEl = document.getElementById('analysis-time');

  loading.style.display = 'block';
  content.innerHTML = '';
  errDiv.style.display = 'none';
  btn.disabled = true;
  btn.textContent = "\u23F3 \u5206\u6790\u4E2D...";

  try {
    const res = await fetch('/api/analysis');
    const data = await res.json();

    if (!data.success) throw new Error(data.error || "\u5206\u6790\u5931\u8D25");

    const report = data.data;
    timeEl.textContent = "\u66F4\u65B0\u4E8E\uFF1A" + new Date(report.timestamp).toLocaleTimeString() + " \xB7 \u5DF2\u5206\u6790\u5E02\u573A\uFF1A" + report.analyzedMarkets + '/' + report.totalMarkets;

    if (report.topOpportunities.length === 0) {
      content.innerHTML = "<div style=\"padding:40px;text-align:center;color:var(--text-secondary);\">\u5F53\u524D\u6CA1\u6709\u53D1\u73B0\u4EA4\u6613\u673A\u4F1A\u3002<br><small>\u53EF\u80FD\u56E0\u4E3A\u8BA2\u5355\u7C3F\u4E3A\u7A7A\u6216\u6D41\u52A8\u6027\u8F83\u4F4E\u3002</small></div>";
      return;
    }

    let html = '';
    for (const rec of report.topOpportunities) {
      const actionClass = rec.action === 'HOLD' ? 'color:var(--text-secondary)' :
      rec.action.startsWith('BUY') ? 'color:var(--green);font-weight:700' : 'color:var(--red);font-weight:700';
      const actionIcon = rec.action === 'HOLD' ? '⏸' : rec.action.startsWith('BUY') ? '🟢' : '🔴';
      const confBar = '<div style="background:var(--border);border-radius:10px;height:8px;overflow:hidden;margin-top:6px;"><div style="background:' + (rec.confidence > 0.7 ? 'var(--green)' : rec.confidence > 0.4 ? 'var(--purple)' : 'var(--red)') + ';height:100%;width:' + Math.round(rec.confidence * 100) + '%;border-radius:10px;"></div></div>';

      html += '<div style="background:var(--bg-card);border-radius:14px;padding:16px;margin-bottom:12px;box-shadow:var(--shadow);">';
      html += '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">';
      html += '<div style="font-weight:600;font-size:14px;">' + (rec.title || "\u5E02\u573A #" + rec.marketId) + '</div>';
      html += '<div style="' + actionClass + ';font-size:14px;white-space:nowrap;">' + actionIcon + ' ' + translateAction(rec.action) + '</div>';
      html += '</div>';
      html += '<div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px;">';
      html += "\u6700\u4F73\u4E70\u4EF7\uFF1A<strong>" + (rec.bestBid ? rec.bestBid.toFixed(4) : '-') + '</strong> | ';
      html += "\u6700\u4F73\u5356\u4EF7\uFF1A<strong>" + (rec.bestAsk ? rec.bestAsk.toFixed(4) : '-') + '</strong> | ';
      html += "\u4EF7\u5DEE\uFF1A<strong>" + (rec.spread ? rec.spread.toFixed(4) : '-') + '</strong> | ';
      html += "24 \u5C0F\u65F6\u6210\u4EA4\u989D\uFF1A<strong>$" + (rec.volume24hUsd ? rec.volume24hUsd.toFixed(0) : '0') + '</strong>';
      html += '</div>';
      html += '<div style="font-size:12px;margin-bottom:4px;">置信度：' + Math.round(rec.confidence * 100) + '%</div>';
      html += confBar;
      html += '<div style="font-size:12px;color:var(--text-secondary);margin-top:8px;">' + (rec.reasons ? rec.reasons.join(' · ') : '') + '</div>';
      html += '</div>';
    }

    content.innerHTML = html;
  } catch (err) {
    errDiv.textContent = '⚠️ ' + err.message;
    errDiv.style.display = 'block';
  } finally {
    loading.style.display = 'none';
    btn.disabled = false;
    btn.textContent = "\uD83D\uDD04 \u5237\u65B0\u5206\u6790";
  }
}


// --- Paper Trading ---
async function loadPaperPortfolio() {
  try {
    const res = await fetch('/api/paper/portfolio');
    const { data: p } = await res.json();

    const statsEl = document.getElementById('paper-stats');
    const pnlColor = p.totalPnl >= 0 ? 'var(--green)' : 'var(--red)';
    const pnlSign = p.totalPnl >= 0 ? '+' : '';
    statsEl.innerHTML = `
          <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
            <div style="font-size:11px;color:var(--text-secondary);">净值</div>
            <div style="font-size:18px;font-weight:700;">$${p.equity.toFixed(2)}</div>
          </div>
          <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
            <div style="font-size:11px;color:var(--text-secondary);">总盈亏</div>
            <div style="font-size:18px;font-weight:700;color:${pnlColor};">${pnlSign}$${p.totalPnl.toFixed(2)}</div>
          </div>
          <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
            <div style="font-size:11px;color:var(--text-secondary);">胜率</div>
            <div style="font-size:18px;font-weight:700;">${(p.winRate * 100).toFixed(0)}%</div>
          </div>
          <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
            <div style="font-size:11px;color:var(--text-secondary);">现金</div>
            <div style="font-size:18px;font-weight:700;">$${p.cashBalance.toFixed(2)}</div>
          </div>
          <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
            <div style="font-size:11px;color:var(--text-secondary);">最大回撤</div>
            <div style="font-size:18px;font-weight:700;color:var(--red);">${p.maxDrawdownPct.toFixed(1)}%</div>
          </div>
        `;

    // Open positions
    const posEl = document.getElementById('paper-positions');
    if (p.positions.filter((x) => x.status === 'OPEN').length === 0) {
      posEl.innerHTML = "<div style=\"color:var(--text-secondary);font-size:13px;padding:10px;\">\u6682\u65E0\u6301\u4ED3</div>";
    } else {
      posEl.innerHTML = p.positions.filter((x) => x.status === 'OPEN').map((pos) => `
            <div style="background:var(--bg-card);border-radius:12px;padding:14px;margin-bottom:8px;box-shadow:var(--shadow);display:flex;justify-content:space-between;align-items:center;">
              <div>
                <div style="font-weight:600;font-size:13px;">${pos.outcomeName} — ${pos.marketTitle.substring(0, 35)}</div>
                <div style="font-size:12px;color:var(--text-secondary);">开仓价： ${pos.entryPrice.toFixed(4)} × ${pos.quantity} 份 | $${(pos.entryPrice * pos.quantity).toFixed(2)}</div>
              </div>
              <button onclick="closePaperPosition('${pos.id}', ${pos.entryPrice})" style="background:var(--red-light);color:var(--red);border:none;padding:6px 14px;border-radius:20px;font-size:12px;cursor:pointer;">平仓</button>
            </div>`).join('');
    }

    // Recent trades
    const tradesRes = await fetch('/api/paper/trades');
    const { data: trades } = await tradesRes.json();
    const tradesEl = document.getElementById('paper-trades');
    if (!trades || trades.length === 0) {
      tradesEl.innerHTML = "<div style=\"color:var(--text-secondary);font-size:13px;padding:10px;\">\u6682\u65E0\u4EA4\u6613</div>";
    } else {
      tradesEl.innerHTML = trades.map((t) => {
        const isBuy = t.action === 'BUY';
        return `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:12px;">
              <span>${isBuy ? '🟢' : '🔴'} ${translateAction(t.action)} ${t.outcomeName}</span>
              <span style="color:var(--text-secondary);">${t.reason}</span>
              <span style="color:var(--text-secondary);">${new Date(t.timestamp).toLocaleTimeString()}</span>
            </div>`;
      }).join('');
    }
  } catch (e) {console.error("\u6A21\u62DF\u76D8\u9519\u8BEF\uFF1A", e);}
}

async function resetPaperPortfolio() {
  if (!confirm("\u786E\u8BA4\u628A\u6A21\u62DF\u8D26\u6237\u91CD\u7F6E\u4E3A $1000 \u5417\uFF1F")) return;
  await fetch('/api/paper/reset', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ startingBalance: 1000 }) });
  loadPaperPortfolio();
}

async function closePaperPosition(positionId, currentPrice) {
  const exitPriceStr = prompt('平仓价格：', currentPrice.toFixed(4));
  if (!exitPriceStr) return;
  const res = await fetch('/api/paper/close', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ positionId, exitPrice: parseFloat(exitPriceStr) }) });
  const data = await res.json();
  alert(data.message);
  loadPaperPortfolio();
}

// --- Backtest ---
async function runBacktest() {
  const lookback = document.getElementById('bt-lookback').value;
  const threshold = document.getElementById('bt-threshold').value;
  const holding = document.getElementById('bt-holding').value;
  const resultsEl = document.getElementById('backtest-results');
  resultsEl.innerHTML = "<div style=\"text-align:center;padding:20px;\">\u23F3 \u6B63\u5728\u8FD0\u884C\u56DE\u6D4B...</div>";

  try {
    const res = await fetch(`/api/backtest?lookback=${lookback}&threshold=${threshold}&holding=${holding}`);
    const { data: r } = await res.json();

    if (r.totalTrades === 0) {
      resultsEl.innerHTML = "<div style=\"padding:20px;text-align:center;color:var(--text-secondary);\">\u5386\u53F2\u6570\u636E\u8FD8\u4E0D\u8DB3\uFF0C\u65E0\u6CD5\u56DE\u6D4B\u3002<br><small>\u673A\u5668\u4EBA\u8FD0\u884C\u5E76\u8BB0\u5F55\u4EF7\u683C\u540E\u4F1A\u9010\u6B65\u79EF\u7D2F\u6570\u636E\u3002</small></div>";
      return;
    }

    const retColor = r.totalReturnPct >= 0 ? 'var(--green)' : 'var(--red)';
    resultsEl.innerHTML = `
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:16px;">
            <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
              <div style="font-size:11px;color:var(--text-secondary);">总收益</div>
              <div style="font-size:20px;font-weight:700;color:${retColor};">${r.totalReturnPct}%</div>
            </div>
            <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
              <div style="font-size:11px;color:var(--text-secondary);">胜率</div>
              <div style="font-size:20px;font-weight:700;">${(r.winRate * 100).toFixed(0)}%</div>
            </div>
            <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
              <div style="font-size:11px;color:var(--text-secondary);">夏普比率</div>
              <div style="font-size:20px;font-weight:700;">${r.sharpeRatio}</div>
            </div>
            <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
              <div style="font-size:11px;color:var(--text-secondary);">最大回撤</div>
              <div style="font-size:20px;font-weight:700;color:var(--red);">${r.maxDrawdownPct}%</div>
            </div>
            <div style="background:var(--bg-card);padding:14px;border-radius:12px;box-shadow:var(--shadow);text-align:center;">
              <div style="font-size:11px;color:var(--text-secondary);">交易次数</div>
              <div style="font-size:20px;font-weight:700;">${r.totalTrades}</div>
            </div>
          </div>

          <div class="section-title">资金曲线</div>
          <canvas id="equity-chart" width="800" height="200" style="width:100%;background:var(--bg-card);border-radius:12px;padding:10px;"></canvas>

          <div class="section-title" style="margin-top:16px;">最近交易</div>
          <table class="data-table">
            <thead><tr><th>市场</th><th>方向</th><th>开仓</th><th>平仓</th><th>盈亏 %</th></tr></thead>
            <tbody>${r.trades.slice(-15).reverse().map((t) =>
    `<tr><td>#${t.marketId}</td><td>${translateAction(t.action)}</td><td>${t.entryPrice}</td><td>${t.exitPrice}</td><td style="color:${t.pnlPct >= 0 ? 'var(--green)' : 'var(--red)'}">${t.pnlPct}%</td></tr>`
    ).join('')}</tbody>
          </table>`;

    // Draw equity curve
    drawEquityChart(r.equityCurve);
  } catch (e) {
    resultsEl.innerHTML = `<div style="color:var(--red);padding:20px;">错误：${e.message}</div>`;
  }
}

function drawEquityChart(curve) {
  const canvas = document.getElementById('equity-chart');
  if (!canvas || curve.length < 2) return;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const minE = Math.min(...curve.map((c) => c.equity));
  const maxE = Math.max(...curve.map((c) => c.equity));
  const range = maxE - minE || 1;

  ctx.strokeStyle = '#7c3aed';
  ctx.lineWidth = 2;
  ctx.beginPath();
  curve.forEach((point, i) => {
    const x = i / (curve.length - 1) * (canvas.width - 40) + 20;
    const y = canvas.height - 30 - (point.equity - minE) / range * (canvas.height - 60);
    if (i === 0) ctx.moveTo(x, y);else
    ctx.lineTo(x, y);
  });
  ctx.stroke();

  // Labels
  ctx.fillStyle = '#6b6b80';
  ctx.font = '10px sans-serif';
  ctx.fillText('$' + maxE.toFixed(0), 5, 15);
  ctx.fillText('$' + minE.toFixed(0), 5, canvas.height - 20);
}

// --- News ---
async function loadNews() {
  const loading = document.getElementById('news-loading');
  const listEl = document.getElementById('news-list');
  loading.style.display = 'block';
  listEl.innerHTML = '';

  try {
    const res = await fetch('/api/news');
    const { data: items } = await res.json();

    loading.style.display = 'none';

    if (!items || items.length === 0) {
      listEl.innerHTML = "<div style=\"color:var(--text-secondary);padding:20px;\">\u6682\u65E0\u65B0\u95FB</div>";
      return;
    }

    listEl.innerHTML = items.map((n) => {
      const s = n.sentimentScore || 0;
      const icon = s > 0.3 ? '🟢' : s > 0 ? '🟡' : s < -0.3 ? '🔴' : '⚪';
      return `<a href="${n.url}" target="_blank" style="text-decoration:none;color:inherit;">
            <div style="background:var(--bg-card);border-radius:12px;padding:14px;margin-bottom:8px;box-shadow:var(--shadow);">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                <div style="font-size:13px;font-weight:500;">${icon} ${n.title}</div>
              </div>
              <div style="font-size:11px;color:var(--text-secondary);margin-top:4px;">
                ${n.source} · ${new Date(n.publishedAt).toLocaleDateString()}
              </div>
            </div></a>`;
    }).join('');

    // Also load correlations
    loadCorrelations();
  } catch (e) {
    loading.style.display = 'none';
    listEl.innerHTML = `<div style="color:var(--red);padding:20px;">新闻加载失败</div>`;
  }
}

async function loadCorrelations() {
  try {
    const res = await fetch('/api/correlations');
    const { data: corrs } = await res.json();
    const el = document.getElementById('correlations-list');

    if (!corrs || corrs.length === 0) {
      el.innerHTML = "<div style=\"color:var(--text-secondary);font-size:13px;\">\u6682\u65E0\u76F8\u5173\u6027\u6570\u636E\uFF1B\u968F\u7740\u65F6\u95F4\u63A8\u79FB\u4F1A\u81EA\u52A8\u79EF\u7D2F\u3002</div>";
      return;
    }

    el.innerHTML = corrs.slice(0, 10).map((c) => {
      const color = c.corr > 0 ? 'var(--green)' : 'var(--red)';
      return `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:12px;">
            <span>${c.titleA.substring(0, 25)} ↔ ${c.titleB.substring(0, 25)}</span>
            <span style="color:${color};font-weight:600;">${c.corr > 0 ? '+' : ''}${c.corr}</span>
          </div>`;
    }).join('');
  } catch (e) {}
}

// --- Settings ---
let settingsLoaded = false;
async function loadSettings() {
  if (settingsLoaded) return;
  try {
    const res = await fetch('/api/settings');
    const { data: s } = await res.json();
    renderSettingsForm(s);
    settingsLoaded = true;
  } catch (e) {}
}

function renderSettingsForm(s) {
  const fields = [
  { key: 'confidenceThreshold', label: "\u7F6E\u4FE1\u5EA6\u9608\u503C", min: 0, max: 1, step: 0.05, desc: "\u8FBE\u5230\u8BE5\u7F6E\u4FE1\u5EA6\u624D\u4F1A\u89E6\u53D1\u4EA4\u6613" },
  { key: 'stopLossPct', label: "\u6B62\u635F\uFF08%\uFF09", min: 5, max: 50, step: 1, desc: "\u4E8F\u635F\u5230\u8BE5\u767E\u5206\u6BD4\u65F6\u5E73\u4ED3" },
  { key: 'takeProfitPct', label: "\u6B62\u76C8\uFF08%\uFF09", min: 10, max: 200, step: 5, desc: "\u76C8\u5229\u5230\u8BE5\u767E\u5206\u6BD4\u65F6\u5E73\u4ED3" },
  { key: 'maxDailyTrades', label: "\u6BCF\u65E5\u6700\u5927\u4EA4\u6613\u6570", min: 1, max: 100, step: 1, desc: "\u6BCF\u5929\u5141\u8BB8\u7684\u6700\u5927\u4EA4\u6613\u6B21\u6570" },
  { key: 'kellyFraction', label: "\u51EF\u5229\u6BD4\u4F8B", min: 0.05, max: 1, step: 0.05, desc: "\u4F7F\u7528\u5B8C\u6574\u51EF\u5229\u516C\u5F0F\u7684\u4E00\u5B9A\u6BD4\u4F8B\uFF08\u8D8A\u4F4E\u8D8A\u4FDD\u5B88\uFF09" },
  { key: 'sentimentWeight', label: "\u60C5\u7EEA\u6743\u91CD", min: 0, max: 1, step: 0.05, desc: "\u60C5\u7EEA\u4FE1\u53F7\u5728\u7B56\u7565\u4E2D\u7684\u6743\u91CD" }];


  const formHtml = fields.map((f) => `
        <div style="margin-bottom:16px;">
          <label style="display:flex;justify-content:space-between;font-size:13px;font-weight:500;margin-bottom:4px;">
            ${f.label}
            <input type="number" id="setting-${f.key}" value="${s[f.key]}" min="${f.min}" max="${f.max}" step="${f.step}"
              onchange="saveSetting('${f.key}', this.value)"
              style="width:80px;padding:4px 8px;border-radius:6px;border:1px solid var(--border);text-align:right;">
          </label>
          <div style="font-size:11px;color:var(--text-secondary);">${f.desc}</div>
        </div>`).join('');

  const toggles = ['paperTradingEnabled', 'telegramEnabled', 'autoTradeEnabled'].map((k) => {
    const labels = { paperTradingEnabled: "\uD83D\uDCDD \u6A21\u62DF\u4EA4\u6613", telegramEnabled: "\uD83D\uDCF1 Telegram \u901A\u77E5", autoTradeEnabled: "\uD83E\uDD16 \u81EA\u52A8\u4EA4\u6613" };
    return `<label style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:13px;">
          ${labels[k]}
          <input type="checkbox" id="setting-${k}" ${s[k] ? 'checked' : ''} onchange="saveSetting('${k}', this.checked)">
        </label>`;
  }).join('');

  document.getElementById('settings-form').innerHTML =
  formHtml + '<div style="height:1px;background:var(--border);margin:16px 0;"></div>' + toggles +
  "<button class=\"tab\" style=\"margin-top:12px;\" onclick=\"resetSettings()\">\u21A9 \u6062\u590D\u9ED8\u8BA4\u8BBE\u7F6E</button>";
}

async function saveSetting(key, value) {
  const body = {};
  body[key] = typeof value === 'boolean' ? value : parseFloat(value);
  await fetch('/api/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
}

async function resetSettings() {
  if (!confirm("\u786E\u8BA4\u6062\u590D\u5168\u90E8\u9ED8\u8BA4\u8BBE\u7F6E\u5417\uFF1F")) return;
  await fetch('/api/settings/reset', { method: 'POST' });
  settingsLoaded = false;
  loadSettings();
}

async function testTelegram() {
  const resultEl = document.getElementById('telegram-result');
  resultEl.textContent = "\u23F3 \u53D1\u9001\u4E2D...";
  const res = await fetch('/api/telegram/test', { method: 'POST' });
  const data = await res.json();
  resultEl.textContent = data.message;
  resultEl.style.color = data.success ? 'var(--green)' : 'var(--red)';
}

async function sendDailyReport() {
  const outputEl = document.getElementById('daily-report-output');
  outputEl.style.display = 'block';
  outputEl.textContent = "\u23F3 \u6B63\u5728\u751F\u6210\u62A5\u544A...";
  const res = await fetch('/api/report/daily', { method: 'POST' });
  const data = await res.json();
  outputEl.textContent = data.data?.report?.replace(/<[^>]*>/g, '') || "\u62A5\u544A\u5DF2\u751F\u6210";
}



