function calcEMA(data, period) {
  const ema = [];
  const k = 2 / (period + 1);
  let prev = data[0];
  ema.push(prev);
  for (let i = 1; i < data.length; i++) {
    prev = data[i] * k + prev * (1 - k);
    ema.push(prev);
  }
  return ema;
}

function calcMACD(data) {
  const closes = data.map(k => k.close);
  const ema12 = calcEMA(closes, 12);
  const ema26 = calcEMA(closes, 26);
  
  const macdLine = ema12.map((v, i) => v - ema26[i]);
  const signalLine = calcEMA(macdLine.slice(25), 9);
  // Pad signal to match length
  const paddedSignal = new Array(25).fill(null).concat(signalLine);
  
  const histogram = macdLine.map((v, i) => 
    paddedSignal[i] !== null ? v - paddedSignal[i] : null
  );
  
  return { macdLine, signalLine: paddedSignal, histogram };
}

function drawMACD(canvas, klines) {
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const padL = 60, padR = 10;
  ctx.clearRect(0, 0, W, H);
  
  const result = calcMACD(klines);
  const allValues = [
    ...result.macdLine.filter(v => v !== null),
    ...result.signalLine.filter(v => v !== null),
    ...result.histogram.filter(v => v !== null)
  ];
  if (!allValues.length) return;
  
  const maxVal = Math.max(...allValues.map(Math.abs)) || 1;
  
  // Zero line
  const zeroY = H / 2;
  ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--border-light') || '#333';
  ctx.beginPath(); ctx.moveTo(padL, zeroY); ctx.lineTo(W - padR, zeroY); ctx.stroke();
  
  const cw = (W - padL - padR) / klines.length;
  
  // Histogram bars
  result.histogram.forEach((v, i) => {
    if (v === null) return;
    const x = padL + i * cw + cw / 2;
    const barH = (Math.abs(v) / maxVal) * (H / 2 - 5);
    ctx.fillStyle = v >= 0 ? 'rgba(34,197,94,.5)' : 'rgba(239,68,68,.5)';
    if (v >= 0) ctx.fillRect(x - cw/4, zeroY - barH, cw/2, barH);
    else ctx.fillRect(x - cw/4, zeroY, cw/2, barH);
  });
  
  // MACD line (blue)
  ctx.strokeStyle = '#3b82f6';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  let started = false;
  result.macdLine.forEach((v, i) => {
    const x = padL + i * cw + cw / 2;
    const y = zeroY - (v / maxVal) * (H / 2 - 5);
    if (!started) { ctx.moveTo(x, y); started = true; }
    else ctx.lineTo(x, y);
  });
  ctx.stroke();
  
  // Signal line (orange)
  ctx.strokeStyle = '#f59e0b';
  ctx.beginPath();
  started = false;
  result.signalLine.forEach((v, i) => {
    if (v === null) return;
    const x = padL + i * cw + cw / 2;
    const y = zeroY - (v / maxVal) * (H / 2 - 5);
    if (!started) { ctx.moveTo(x, y); started = true; }
    else ctx.lineTo(x, y);
  });
  ctx.stroke();
  ctx.lineWidth = 1;
}


