    const eth = d.crypto?.find((c) => c.symbol === 'ETHUSDT');

    let html = `
          <div style="background:linear-gradient(135deg,var(--purple),var(--purple-dark));padding:14px;border-radius:14px;color:white;">
            <div style="font-size:11px;opacity:0.8;">模拟净值</div>
            <div style="font-size:22px;font-weight:800;">$${d.paper.equity.toFixed(2)}</div>
            <div style="font-size:12px;opacity:0.9;">${d.paper.totalPnl >= 0 ? '+' : ''}$${d.paper.totalPnl.toFixed(2)} 盈亏</div>
          </div>`;

    if (btc) {
      const c = btc.change24hPct >= 0 ? '#4ade80' : '#f87171';
      html += `<div style="background:var(--bg-card);padding:14px;border-radius:14px;box-shadow:var(--shadow);">
            <div style="font-size:11px;color:var(--text-secondary);">BTC</div>
            <div style="font-size:20px;font-weight:700;">$${btc.price.toLocaleString(undefined, { maximumFractionDigits: 0 })}</div>
            <div style="font-size:12px;color:${c};">${btc.change24hPct >= 0 ? '▲' : '▼'} ${Math.abs(btc.change24hPct).toFixed(1)}%</div>
          </div>`;
    }
    if (eth) {
      const c = eth.change24hPct >= 0 ? '#4ade80' : '#f87171';
      html += `<div style="background:var(--bg-card);padding:14px;border-radius:14px;box-shadow:var(--shadow);">
            <div style="font-size:11px;color:var(--text-secondary);">ETH</div>
            <div style="font-size:20px;font-weight:700;">$${eth.price.toLocaleString(undefined, { maximumFractionDigits: 0 })}</div>
            <div style="font-size:12px;color:${c};">${eth.change24hPct >= 0 ? '▲' : '▼'} ${Math.abs(eth.change24hPct).toFixed(1)}%</div>
          </div>`;
    }

    html += `<div style="background:var(--bg-card);padding:14px;border-radius:14px;box-shadow:var(--shadow);text-align:center;">
          <div style="font-size:11px;color:var(--text-secondary);">胜率</div>
          <div style="font-size:22px;font-weight:700;">${(d.paper.winRate * 100).toFixed(0)}%</div>
          <div style="font-size:12px;color:var(--text-secondary);">${d.paper.openPositions} 个未平仓</div>
        </div>`;

    el.innerHTML = html;
  } catch (e) {}
}


async function loadAll() {
  loadOverview();
  loadMovers();
  loadBalance();
  loadWallet();
  await loadCategories();
}

async function refresh() {
  showToast("正在刷新...", "info");
  try {
    await loadAll();
loadMarketOverview();
    if (selectedCategory) {
      await loadCategoryOrderbooks(selectedCategory);
      renderOutcomes();
    }
    showToast("刷新完成", "success");
  } catch(e) {
    showToast("刷新失败", "error");
  }
}

async function loadCategories(retryCount = 0) {
  document.getElementById('loading').style.display = 'block';
  document.getElementById('categories-list').innerHTML = '';

  // Keep client-side stats cache on refresh (server handles freshness)

  try {
    const res = await fetch('/api/categories');
    const data = await res.json();
    if (!data.success) throw new Error(data.error);

    categoriesData = data.data;

    // Render immediately without waiting for stats
    renderCategories();
    document.getElementById('loading').style.display = 'none';

    // Load stats in background (don't block)
    loadStatsInBackground();
  } catch (err) {
    // Auto-retry on rate limit
    const isRateLimit = err.message.includes("\u8BF7\u6C42\u9891\u7387\u9650\u5236") || err.message.includes('429');
    if (isRateLimit && retryCount < 2) {
      showToast("\u8BF7\u6C42\u8FC7\u4E8E\u9891\u7E41\uFF0C5 \u79D2\u540E\u91CD\u8BD5...", 'warning');
      setTimeout(() => loadCategories(retryCount + 1), 5000);
      return;
    }

    showToast(err.message, 'error');
    document.getElementById('loading').style.display = 'none';
  }
}

async function loadStatsInBackground() {
  // Load stats AND orderbooks together in parallel for each market
  const allMarkets = [];
  for (const cat of categoriesData) {
    for (const m of cat.markets) {
      allMarkets.push({ cat, m });
    }
  }

  // Load in larger batches of 20 for speed
  for (let i = 0; i < allMarkets.length; i += 20) {
    const batch = allMarkets.slice(i, i + 20);
    await Promise.all(batch.map(async ({ cat, m }) => {
      // Load stats and orderbook in parallel for each market
      const [statsRes, obRes] = await Promise.all([
      fetch(`/api/markets/${m.id}/stats`).then((r) => r.json()).catch(() => null),
      fetch(`/api/markets/${m.id}/orderbook`).then((r) => r.json()).catch(() => null)]
      );

      // Process stats
      if (statsRes?.success) {
        if (!categoryStatsCache[cat.id]) {
          categoryStatsCache[cat.id] = { volume: 0, liquidity: 0 };
        }
        categoryStatsCache[cat.id].volume += statsRes.data.volumeTotalUsd || 0;
        categoryStatsCache[cat.id].liquidity += statsRes.data.totalLiquidityUsd || 0;
      }

      // Process orderbook
      if (obRes?.success) {
        orderbooksCache[m.id] = obRes.data;
        const ob = obRes.data;
        let odds = null;
        if (ob.bids.length > 0 && ob.asks.length > 0) {
          odds = (ob.bids[0][0] + ob.asks[0][0]) / 2;
        } else if (ob.asks.length > 0) {
          odds = ob.asks[0][0];
        } else if (ob.bids.length > 0) {
          odds = ob.bids[0][0];
        }
        if (!categoryOddsCache[cat.id]) categoryOddsCache[cat.id] = [];
        categoryOddsCache[cat.id].push({ market: m, odds });
      }
    }));
    // Update UI after all batches complete
    if (i + 20 >= allMarkets.length) {
      renderCategories();
      // Re-apply selected class after re-render
      if (selectedCategory) {
        document.querySelectorAll('.category-card').forEach(card => {
          card.classList.toggle('selected', card.getAttribute('onclick') === 'selectCategory(' + selectedCategory.id + ')');
        });
      }
    }
  }
}

async function loadBalance() {
  try {
    const res = await fetch('/api/balance');
    const data = await res.json();
    if (data.success && data.data) {
      // Show actual USDT balance in header
      const usdtBal = parseFloat(data.data.usdtFormatted || '0');
      document.getElementById('balance-display').textContent = '$' + usdtBal.toFixed(2);
    } else {
      document.getElementById('balance-display').textContent = '$0.00';
    }
  } catch (err) {
    document.getElementById('balance-display').textContent = '$0.00';
  }
}

async function loadWallet() {
  try {
    const res = await fetch('/api/wallet');
    const data = await res.json();
    if (data.success) {
      const a = data.data.address;
      const info = data.data;

      // Show address with type indicator
      let label = a.slice(0, 6) + '...' + a.slice(-4);
      if (info.usingPredictAccount) {
        label = '🔐 ' + label;
      }
      document.getElementById('wallet-address').textContent = label;

      // Set BscScan link
      document.getElementById('wallet-link').href = 'https://bscscan.com/address/' + a;

      // Set tooltip with full info
      let tooltip = '地址：' + a;
      if (info.usingPredictAccount) {
        tooltip += '\n类型：Predict 账户（智能钱包）';
        tooltip += '\nEOA: ' + info.eoaAddress;
      } else {
        tooltip += '\n类型：EOA（直接钱包）';
      }
      tooltip += '\n点击在 BscScan 查看';
      document.getElementById('wallet-link').title = tooltip;
    }
  } catch (err) {}
}

function renderCategories() {
  const container = document.getElementById('categories-list');

  container.innerHTML = categoriesData.map((cat) => {
    const numOutcomes = cat.markets.length;
    const isBinary = numOutcomes === 1 && cat.markets[0].outcomes.length === 2;
    const stats = categoryStatsCache[cat.id] || { volume: 0, liquidity: 0 };
    const oddsData = categoryOddsCache[cat.id] || [];

    // Sort by odds descending to find favorite
    const sortedOdds = [...oddsData].filter((o) => o.odds !== null).sort((a, b) => b.odds - a.odds);
    const maxOdds = sortedOdds[0]?.odds || 0;

    let oddsHtml = '';
    if (sortedOdds.length > 0) {
      oddsHtml = '<div class="cat-odds">';
      // Show top 3 or all if less
      sortedOdds.slice(0, 3).forEach((item, idx) => {
        const isFavorite = item.odds === maxOdds;
        const pct = (item.odds * 100).toFixed(0);
        oddsHtml += `
              <div class="odds-chip ${isFavorite ? 'favorite' : ''}">
                <span class="name">${item.market.title}</span>
                <span class="pct">${pct}%</span>
              </div>
            `;
      });
      if (sortedOdds.length > 3) {
        oddsHtml += `<div class="odds-chip"><span class="name">+${sortedOdds.length - 3} 个更多</span></div>`;
      }
      oddsHtml += '</div>';
    }

    return `
          <div class="category-card ${selectedCategory?.id === cat.id ? 'selected' : ''}"
               onclick="selectCategory(${cat.id})">
            <div class="cat-header">
              <div class="cat-title">${cat.title}</div>
              <div class="cat-badge">${isBinary ? '是/否' : numOutcomes + ' 个结果'}</div>
            </div>
            <div class="cat-stats">
              <span>成交额：<strong>$${Math.round(stats.volume).toLocaleString()}</strong></span>
              <span>流动性：<strong>$${Math.round(stats.liquidity).toLocaleString()}</strong></span>
            </div>
            ${oddsHtml}
          </div>
        `;
  }).join('');
}

async function selectCategory(catId) {
  // Prevent double-click while loading
  if (selectCategory._loading) return;
  selectCategory._loading = true;

  selectedCategory = categoriesData.find((c) => c.id === catId);
  if (!selectedCategory) { selectCategory._loading = false; return; }
  selectedMarket = null;
  showConditions = false;

  // Update selection highlight without re-rendering (prevents DOM detachment)
  document.querySelectorAll('.category-card').forEach(card => {
    card.classList.toggle('selected', card.getAttribute('onclick') === 'selectCategory(' + catId + ')');
  });

  document.getElementById('sidebar-title').textContent = selectedCategory.title;
  document.getElementById('sidebar-subtitle').textContent =
  selectedCategory.markets.length === 1 ? "\u4E8C\u5143\u5E02\u573A" : selectedCategory.markets.length + ' 个结果';

  document.getElementById('no-selection').style.display = 'none';
  document.getElementById('outcomes-container').style.display = 'block';
  document.getElementById('outcomes-container').innerHTML = '<div class="loading"><div class="spinner"></div></div>';

  await loadCategoryOrderbooks(selectedCategory);
  renderOutcomes();
  selectCategory._loading = false;
}

async function loadCategoryOrderbooks(category) {
  const promises = category.markets.map((m) =>
  fetch(`/api/markets/${m.id}/orderbook`).
  then((r) => r.json()).
  then((data) => {if (data.success) orderbooksCache[m.id] = data.data;}).
  catch(() => {})
  );
  await Promise.all(promises);
}

function toggleConditions() {
  showConditions = !showConditions;
  renderOutcomes();
}

function renderOutcomes() {
  const container = document.getElementById('outcomes-container');
  let html = '';

  // Conditions button - show market description if available, fallback to category
  const firstMarket = selectedCategory.markets[0];
  const resolutionText = firstMarket?.description || selectedCategory.description;
  if (resolutionText) {
    html += `
          <button class="conditions-btn" onclick="toggleConditions()">
            📋 ${showConditions ? '隐藏' : '显示'} 结算条件
          </button>
          <div class="conditions-box ${showConditions ? 'show' : ''}">${resolutionText}</div>
        `;
  }

  html += "<div class=\"outcomes-section\"><div class=\"outcomes-title\">\u9009\u62E9\u7ED3\u679C</div>";

  html += selectedCategory.markets.map((m) => {
    const ob = orderbooksCache[m.id] || { bids: [], asks: [] };
    const isSelected = selectedMarket?.id === m.id;

    // Calculate YES and NO odds
    let yesOdds = null;
    if (ob.bids.length > 0 && ob.asks.length > 0) {
      yesOdds = (ob.bids[0][0] + ob.asks[0][0]) / 2;
    } else if (ob.asks.length > 0) {
      yesOdds = ob.asks[0][0];
    } else if (ob.bids.length > 0) {
      yesOdds = ob.bids[0][0];
    }
    const yesPct = yesOdds ? (yesOdds * 100).toFixed(0) : '-';
    const noPct = yesOdds ? (100 - yesOdds * 100).toFixed(0) : '-';

    return `
          <div class="outcome-card ${isSelected ? 'selected' : ''}" onclick="selectMarket(${m.id})">
            <div class="outcome-header">
              <span class="outcome-name">${m.title}</span>
              <div style="display:flex;gap:6px;">
                <span class="odds-chip" style="background:var(--green-light)"><span class="pct" style="color:var(--green)">看涨 ${yesPct}%</span></span>
                <span class="odds-chip" style="background:var(--red-light)"><span class="pct" style="color:var(--red)">看跌 ${noPct}%</span></span>
              </div>
            </div>
            <div class="orderbook-mini">
              <div class="ob-col asks">
                <h5>买入看涨（${ob.asks.length})</h5>
                ${ob.asks.length > 0 ? ob.asks.slice(0, 10).map((a) => `
                  <div class="ob-row">
                    <span class="price">${(a[0] * 100).toFixed(0)}¢</span>
                    <span class="size">${a[1].toFixed(0)}</span>
                  </div>
                `).join('') : '<div class="ob-empty">-</div>'}
              </div>
              <div class="ob-col bids">
                <h5>卖出看涨（${ob.bids.length})</h5>
                ${ob.bids.length > 0 ? ob.bids.slice(0, 10).map((b) => `
                  <div class="ob-row">
                    <span class="price">${(b[0] * 100).toFixed(0)}¢</span>
                    <span class="size">${b[1].toFixed(0)}</span>
                  </div>
                `).join('') : '<div class="ob-empty">-</div>'}
              </div>
            </div>
          </div>
        `;
  }).join('');

  html += '</div>';

  if (selectedMarket) {
    const ob = orderbooksCache[selectedMarket.id] || { bids: [], asks: [] };
    const isYes = tradeState.side === 'yes';

    // For YES: buy from asks, sell to bids
    // For NO: buy from bids (inverted), sell to asks (inverted)
    let buyOrders, sellOrders, defaultPrice;

    if (isYes) {
      // YES perspective: ASKS = buy prices, BIDS = sell prices
      buyOrders = ob.asks.slice(0, 8).map((a) => ({ price: a[0], size: a[1] }));
      sellOrders = ob.bids.slice(0, 8).map((b) => ({ price: b[0], size: b[1] }));
      defaultPrice = ob.asks[0]?.[0] || ob.bids[0]?.[0] || 0.5;
    } else {
      // NO perspective: invert prices (1 - price)
      // To buy NO, you sell YES (hit bids) - your cost = 1 - bid price
      // To sell NO, you buy YES (lift asks) - you receive = 1 - ask price
      buyOrders = ob.bids.slice(0, 8).map((b) => ({ price: 1 - b[0], size: b[1] }));
      sellOrders = ob.asks.slice(0, 8).map((a) => ({ price: 1 - a[0], size: a[1] }));
      defaultPrice = ob.bids[0] ? 1 - ob.bids[0][0] : ob.asks[0] ? 1 - ob.asks[0][0] : 0.5;
    }

    html += `
          <div class="trade-section">
            <div class="trade-title">下单目标： ${selectedMarket.title}</div>

            <div class="trade-orderbook">
              <div class="trade-ob-header">${isYes ? '看涨' : '看跌'}订单簿</div>
              <div class="orderbook-mini" style="margin-bottom:12px;">
                <div class="ob-col asks">
                  <h5 style="color:var(--green)">买入 ${isYes ? "看涨" : "看跌"}</h5>
                  ${buyOrders.length > 0 ? buyOrders.map((o) => `
                    <div class="ob-row">
                      <span class="price" style="color:var(--green)">${(o.price * 100).toFixed(0)}¢</span>
                      <span class="size">${o.size.toFixed(0)}</span>
                    </div>
                  `).join('') : '<div class="ob-empty">-</div>'}
                </div>
                <div class="ob-col bids">
                  <h5 style="color:var(--red)">卖出 ${isYes ? "看涨" : "看跌"}</h5>
                  ${sellOrders.length > 0 ? sellOrders.map((o) => `
                    <div class="ob-row">
                      <span class="price" style="color:var(--red)">${(o.price * 100).toFixed(0)}¢</span>
                      <span class="size">${o.size.toFixed(0)}</span>
                    </div>
                  `).join('') : '<div class="ob-empty">-</div>'}
                </div>
              </div>
            </div>

            <form class="trade-form" onsubmit="submitTrade(event)">
              <div class="form-row">
                <div class="form-label">方向</div>
                <div class="side-btns">
                  <button type="button" class="side-btn yes ${tradeState.side === 'yes' ? 'active' : ''}" onclick="setSide('yes')">看涨</button>
                  <button type="button" class="side-btn no ${tradeState.side === 'no' ? 'active' : ''}" onclick="setSide('no')">看跌</button>
                </div>
              </div>

              <div class="form-row">
                <div class="form-label">类型</div>
                <div class="type-btns">
                  <button type="button" class="type-btn ${tradeState.orderType === 'LIMIT' ? 'active' : ''}" onclick="setOrderType('LIMIT')">限价</button>
                  <button type="button" class="type-btn ${tradeState.orderType === 'MARKET' ? 'active' : ''}" onclick="setOrderType('MARKET')">市价</button>
                </div>
              </div>

              <div class="form-row" id="price-row" style="display:${tradeState.orderType === 'LIMIT' ? 'flex' : 'none'}">
                <div class="form-label">价格</div>
                <div class="input-group">
                  <input type="number" id="price-input" step="0.01" min="0.01" max="0.99" value="${defaultPrice.toFixed(2)}" oninput="updateSummary()">
                  <span class="input-suffix">$</span>
                </div>
              </div>

              <div class="form-row">
                <div class="form-label">份数</div>
                <div class="input-group">
                  <input type="number" id="qty-input" step="1" min="1" value="10" oninput="updateSummary()">
                  <span class="input-suffix">份</span>
                </div>
              </div>

              <div class="summary-box">
                <div class="summary-row">
                  <span class="label">每份价格</span>
                  <span class="value" id="sum-price">$${defaultPrice.toFixed(2)}</span>
                </div>
                <div class="summary-row">
                  <span class="label">份数</span>
                  <span class="value" id="sum-qty">10</span>
                </div>
                <div class="summary-row">
                  <span class="label">成本（你支付）</span>
                  <span class="value" id="sum-total">$${(defaultPrice * 10).toFixed(2)}</span>
                </div>
                <div class="summary-row" style="border-top:1px solid var(--border);margin-top:6px;padding-top:6px;">
                  <span class="label">如果获胜</span>
                  <span class="value" style="color:var(--green)" id="sum-payout">$10.00</span>
                </div>
                <div class="summary-row total" style="background:var(--green-light);margin:-8px;margin-top:8px;padding:10px;border-radius:6px;">
                  <span class="label" style="color:var(--green)">潜在利润</span>
                  <span class="value" style="color:var(--green)" id="sum-profit">+$${(10 - defaultPrice * 10).toFixed(2)}</span>
                </div>
              </div>

              <button type="submit" class="submit-btn ${tradeState.side}" id="submit-btn">
                买入 ${tradeState.side === "yes" ? "看涨" : "看跌"}
              </button>
            </form>
          </div>
        `;
  }

  container.innerHTML = html;
}

function selectMarket(marketId) {
  selectedMarket = selectedCategory.markets.find((m) => m.id === marketId);
  tradeState.side = 'yes';
  renderOutcomes();
}

function setSide(side) {tradeState.side = side;renderOutcomes();}
function setOrderType(type) {tradeState.orderType = type;renderOutcomes();}

function updateSummary() {
  const price = parseFloat(document.getElementById('price-input')?.value) || 0;
  const qty = parseInt(document.getElementById('qty-input')?.value) || 0;
  const cost = price * qty;
  const payout = qty * 1; // Each share pays $1 if you win
  const profit = payout - cost;

  if (document.getElementById('sum-price')) {
    document.getElementById('sum-price').textContent = '$' + price.toFixed(2);
    document.getElementById('sum-qty').textContent = qty;
    document.getElementById('sum-total').textContent = '$' + cost.toFixed(2);
    document.getElementById('sum-payout').textContent = '$' + payout.toFixed(2);
    document.getElementById('sum-profit').textContent = '+$' + profit.toFixed(2);
  }
}

async function submitTrade(e) {
  e.preventDefault();
  if (!selectedMarket) return;

  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.textContent = '处理中...';

  try {
    const side = tradeState.side === 'yes' ? 0 : 1;
    const res = await fetch('/api/trade', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        marketId: selectedMarket.id,
        side: side,
        outcomeIndex: 0,
        orderType: tradeState.orderType,
        price: parseFloat(document.getElementById('price-input').value),
        quantity: parseInt(document.getElementById('qty-input').value)
      })
    });

    const data = await res.json();
    if (data.success) {
      showToast("\u8BA2\u5355\u5DF2\u63D0\u4EA4\uFF01", 'success');
      loadBalance();
      await loadCategoryOrderbooks(selectedCategory);
      renderOutcomes();
    } else {
      throw new Error(data.error);
    }
  } catch (err) {
    showToast('错误：' + err.message, 'error');
  } finally {
    btn.disabled = false;
    btn.textContent = `买入 ${tradeState.side === "yes" ? "看涨" : "看跌"}`;
  }
}

function showTab(tab) {
  document.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
  event.target.classList.add('active');
  document.querySelectorAll('.tab-content').forEach((c) => c.classList.remove('active'));
  document.getElementById(tab + '-tab').classList.add('active');

  if (tab === 'positions') loadPositions();
  if (tab === 'orders') loadOrders();
  if (tab === 'paper') loadPaperPortfolio();
  if (tab === 'analysis') {} // Already has refresh button
  if (tab === 'news') loadNews();
  if (tab === 'settings') {loadSettings();loadConnectionInfo();}
  if (tab === 'binance') loadBinanceDashboard();
  if (tab === 'stocks') { loadStockQuotes(); loadStockKline(); loadDefiData(); loadMacroIndicators(); loadCryptoNews(); loadChainTVL(); loadVolumeRanking(); loadDefiYields(); loadDecryptNews(); loadBtcMagNews(); }
  if (tab === 'alerts') loadAlerts();
  if (tab === 'whales') loadWhales();
  if (tab === 'strategies') loadStrategies();
  if (tab === 'journal') loadJournal();
}

let positionsData = [];

async function loadPositions() {
  const list = document.getElementById('positions-list');
  list.innerHTML = "<tr><td colspan=\"5\" class=\"empty-state\">\u52A0\u8F7D\u4E2D...</td></tr>";

  try {
    const res = await fetch('/api/positions');
    const data = await res.json();

    if (data.success && data.data && data.data.length > 0) {
      positionsData = data.data;
      list.innerHTML = data.data.map((p, idx) => {
        const shares = parseFloat(p.amount) / 1e18;
        return `
            <tr>
              <td><strong>${p.market.title}</strong></td>
              <td>${p.outcome.name}</td>
              <td>${shares.toFixed(2)}</td>
              <td style="color:var(--green);font-weight:600">$${parseFloat(p.valueUsd).toFixed(2)}</td>
              <td><button class="cancel-btn" style="background:var(--red);color:white" onclick="openSellModal(${idx})">卖出</button></td>
            </tr>
          `;}).join('');
    } else {
      positionsData = [];
      list.innerHTML = "<tr><td colspan=\"5\" class=\"empty-state\">\u6682\u65E0\u6301\u4ED3</td></tr>";
    }
  } catch (err) {
    list.innerHTML = "<tr><td colspan=\"5\" class=\"empty-state\">\u52A0\u8F7D\u5931\u8D25</td></tr>";
  }
}

async function loadOrders() {
  const list = document.getElementById('orders-list');
  list.innerHTML = "<div class=\"orders-empty\"><div class=\"orders-empty-icon\">\u23F3</div>\u52A0\u8F7D\u4E2D...</div>";

  try {
    const res = await fetch('/api/orders');
    const data = await res.json();

    if (data.success && data.data && data.data.length > 0) {
      // Load market titles in parallel
      const marketIds = [...new Set(data.data.map((o) => o.marketId))];
      const marketTitles = {};
      await Promise.all(marketIds.map(async (id) => {
        try {
          const mRes = await fetch(`/api/markets/${id}`);
          const mData = await mRes.json();
          if (mData.success) marketTitles[id] = mData.data.title;
        } catch {}
      }));

      list.innerHTML = data.data.map((o) => {
        const isBuy = o.order.side === 0;
        const makerAmt = parseFloat(o.order.makerAmount) / 1e18;
        const takerAmt = parseFloat(o.order.takerAmount) / 1e18;

        // Price and quantity calculation
        const price = isBuy ? makerAmt / takerAmt : takerAmt / makerAmt;
        const qty = isBuy ? takerAmt : makerAmt;
        const total = price * qty;
        const filled = parseFloat(o.amountFilled || '0') / 1e18;
        const fillPct = qty > 0 ? (filled / qty * 100).toFixed(0) : 0;

        const title = marketTitles[o.marketId] || `市场 #${o.marketId}`;

        return `
            <div class="order-card">
              <div class="order-side ${isBuy ? 'buy' : 'sell'}">
                ${isBuy ? '买入' : '卖出'}
              </div>
              <div class="order-info">
                <div class="order-market" title="${title}">${title}</div>
                <div class="order-details">
                  <div class="order-detail">
                    <span class="order-detail-label">价格</span>
                    <span class="order-detail-value">$${price.toFixed(2)}</span>
                  </div>
                  <div class="order-detail">
                    <span class="order-detail-label">数量</span>
                    <span class="order-detail-value">${qty.toFixed(0)} 份</span>
                  </div>
                  <div class="order-detail">
                    <span class="order-detail-label">总额</span>
                    <span class="order-detail-value">$${total.toFixed(2)}</span>
                  </div>
                  <div class="order-detail">
                    <span class="order-detail-label">成交量</span>
                    <span class="order-detail-value">${fillPct}%</span>
                  </div>
                </div>
              </div>
              <div class="order-actions">
                <div class="order-status">${o.strategy}</div>
                <button class="cancel-btn" onclick="cancelOrder('${o.id}')">取消</button>
              </div>
            </div>
          `;}).join('');
    } else {
      list.innerHTML = "<div class=\"orders-empty\"><div class=\"orders-empty-icon\">\uD83D\uDCCB</div>\u6682\u65E0\u672A\u5B8C\u6210\u8BA2\u5355</div>";
    }
  } catch (err) {
    list.innerHTML = "<div class=\"orders-empty\"><div class=\"orders-empty-icon\">\u26A0\uFE0F</div>\u8BA2\u5355\u52A0\u8F7D\u5931\u8D25</div>";
  }
}

async function cancelOrder(orderId) {
  try {
    const res = await fetch('/api/orders/cancel', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderIds: [orderId] })
    });
    const data = await res.json();
    if (data.success) {
      showToast("\u8BA2\u5355\u5DF2\u53D6\u6D88", 'success');
      loadOrders();
    } else {
      throw new Error(data.error);
    }
  } catch (err) {
    showToast('错误：' + err.message, 'error');
  }
}

function showToast(message, type) {
  const toast = document.getElementById('toast');

  // Handle rate limit messages specially
  if (message.includes("\u8BF7\u6C42\u9891\u7387\u9650\u5236") || message.includes('429')) {
    message = "\u8BF7\u6C42\u8FC7\u4E8E\u9891\u7E41\uFF0C\u8BF7\u7A0D\u7B49...";
    type = 'warning';
  }

  toast.textContent = message;
  toast.className = 'toast ' + type + ' show';
  setTimeout(() => toast.classList.remove('show'), 4000);
}

let walletAddress = '';

async function showWalletModal() {
  document.getElementById('wallet-modal').style.display = 'flex';

  // Load wallet info
  try {
    const res = await fetch('/api/wallet');
    const data = await res.json();
    if (data.success) {
      walletAddress = data.data.address;
      document.getElementById('full-address').textContent = walletAddress;
      document.getElementById('bscscan-link').href = 'https://bscscan.com/address/' + walletAddress;
    }
  } catch {}

  // Load balance
  try {
    const res = await fetch('/api/balance');
    const data = await res.json();
    if (data.success && data.data) {
      const sdkBal = parseFloat(data.data.formatted || '0');
      const usdtBal = parseFloat(data.data.usdtFormatted || '0');

      document.getElementById('modal-sdk-balance').textContent = '$' + sdkBal.toFixed(2);
      document.getElementById('modal-usdt-balance').textContent = '$' + usdtBal.toFixed(2);

      // Show warnings
      document.getElementById('balance-warning').style.display = usdtBal === 0 ? 'block' : 'none';
      document.getElementById('deposit-note').style.display = usdtBal > 0 && sdkBal === 0 ? 'block' : 'none';
    } else {
      document.getElementById('modal-sdk-balance').textContent = '$0.00';
      document.getElementById('modal-usdt-balance').textContent = '$0.00';
      document.getElementById('balance-warning').style.display = 'block';
    }
  } catch {
    document.getElementById('modal-sdk-balance').textContent = '$0.00';
    document.getElementById('modal-usdt-balance').textContent = '$0.00';
    document.getElementById('balance-warning').style.display = 'block';
  }
}

function closeWalletModal() {
  document.getElementById('wallet-modal').style.display = 'none';
}

function copyAddress() {
  if (walletAddress) {
    navigator.clipboard.writeText(walletAddress);
    showToast("\u5730\u5740\u5DF2\u590D\u5236\uFF01", 'success');
  }
}

async function setApprovals() {
  const btn = document.getElementById('approvals-btn');
  btn.disabled = true;
  btn.textContent = "\u6B63\u5728\u8BBE\u7F6E\u6388\u6743...";

  try {
    const res = await fetch('/api/approvals', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      showToast("\u5408\u7EA6\u6388\u6743\u8BBE\u7F6E\u6210\u529F\uFF01", 'success');
      btn.textContent = "\u2713 \u6388\u6743\u5DF2\u8BBE\u7F6E";
    } else {
      throw new Error(data.error);
    }
  } catch (err) {
    showToast('错误：' + err.message, 'error');
    btn.disabled = false;
    btn.textContent = "\u8BBE\u7F6E\u6388\u6743";
  }
}

// Close modal on outside click
document.getElementById('wallet-modal').addEventListener('click', (e) => {
  if (e.target.id === 'wallet-modal') closeWalletModal();
});

// ========== SELL POSITION FUNCTIONS ==========
let currentSellPosition = null;
let sellOrderType = 'LIMIT';
let sellBestBid = null;

async function openSellModal(positionIdx) {
  const pos = positionsData[positionIdx];
  if (!pos) return;

  currentSellPosition = pos;
  sellOrderType = 'LIMIT';

  // Update modal content
  document.getElementById('sell-market-title').textContent = pos.market.title;
  document.getElementById('sell-outcome-name').textContent = pos.outcome.name;

  const shares = parseFloat(pos.amount) / 1e18;
  document.getElementById('sell-available-shares').textContent = shares.toFixed(2);
  document.getElementById('sell-available-value').textContent = parseFloat(pos.valueUsd).toFixed(2);

  // Reset inputs
  document.getElementById('sell-quantity').value = '';
  document.getElementById('sell-price').value = '';
  document.getElementById('sell-total').textContent = '$0.00';

  // Reset order type buttons
  document.getElementById('sell-type-limit').classList.add('active');
  document.getElementById('sell-type-market').classList.remove('active');
  document.getElementById('sell-price-section').style.display = 'block';

  // Load orderbook to get best bid
  sellBestBid = null;
  document.getElementById('sell-best-bid').textContent = '加载中...';

  try {
    const res = await fetch(`/api/markets/${pos.market.id}/orderbook`);
    const data = await res.json();
    if (data.success && data.data.bids && data.data.bids.length > 0) {
      sellBestBid = data.data.bids[0][0];
      document.getElementById('sell-best-bid').textContent = '$' + sellBestBid.toFixed(2);
      document.getElementById('sell-price').value = sellBestBid.toFixed(2);
      updateSellTotal();
    } else {
      document.getElementById('sell-best-bid').textContent = "\u6682\u65E0\u4E70\u4EF7";
    }
  } catch (err) {
    document.getElementById('sell-best-bid').textContent = '加载失败';
  }

  // Show modal
  document.getElementById('sell-modal').style.display = 'flex';
}

function closeSellModal() {
  document.getElementById('sell-modal').style.display = 'none';
  currentSellPosition = null;
}

function setSellOrderType(type) {
  sellOrderType = type;
  document.getElementById('sell-type-limit').classList.toggle('active', type === 'LIMIT');
  document.getElementById('sell-type-market').classList.toggle('active', type === 'MARKET');
  document.getElementById('sell-price-section').style.display = type === 'LIMIT' ? 'block' : 'none';
  updateSellTotal();
}

function setSellMax() {
  if (!currentSellPosition) return;
  const shares = parseFloat(currentSellPosition.amount) / 1e18;
  document.getElementById('sell-quantity').value = Math.floor(shares);
  updateSellTotal();
}

function updateSellTotal() {
  const qty = parseFloat(document.getElementById('sell-quantity').value) || 0;
  let price = 0;

  if (sellOrderType === 'LIMIT') {
    price = parseFloat(document.getElementById('sell-price').value) || 0;
  } else {
    price = sellBestBid || 0;
  }

  const total = qty * price;
  document.getElementById('sell-total').textContent = '$' + total.toFixed(2);
}

// Update total on input change
document.getElementById('sell-quantity').addEventListener('input', updateSellTotal);
document.getElementById('sell-price').addEventListener('input', updateSellTotal);

async function submitSellOrder() {
  if (!currentSellPosition) return;

  const qty = parseFloat(document.getElementById('sell-quantity').value);
  if (!qty || qty <= 0) {
    showToast("\u8BF7\u8F93\u5165\u6570\u91CF", 'error');
    return;
  }

  let price = null;
  if (sellOrderType === 'LIMIT') {
    price = parseFloat(document.getElementById('sell-price').value);
    if (!price || price <= 0 || price >= 1) {
      showToast("\u8BF7\u8F93\u5165\u6709\u6548\u4EF7\u683C\uFF080.01-0.99\uFF09", 'error');
      return;
    }
  }

  const btn = document.getElementById('sell-submit-btn');
  btn.disabled = true;
  btn.textContent = "\u5356\u51FA\u4E2D...";

  try {
    // Find outcome index (YES=0, NO=1)
    const outcomeIndex = currentSellPosition.outcome.indexSet === 1 ? 0 : 1;

    const body = {
      marketId: currentSellPosition.market.id,
      side: 1, // SELL = 1
      outcomeIndex: outcomeIndex,
      orderType: sellOrderType,
      quantity: qty
    };

    if (sellOrderType === 'LIMIT') {
      body.price = price;
    }

    const res = await fetch('/api/trade', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });

    const data = await res.json();
    if (data.success) {
      showToast("\u5356\u5355\u5DF2\u63D0\u4EA4\uFF01", 'success');
      closeSellModal();
      loadPositions(); // Refresh positions
    } else {
      throw new Error(data.error || "\u4E0B\u5355\u5931\u8D25");
    }
  } catch (err) {
    showToast('错误：' + err.message, 'error');
  } finally {
    btn.disabled = false;
    btn.textContent = "\u5356\u51FA\u6301\u4ED3";
  }
}

// Close sell modal on outside click
document.getElementById('sell-modal').addEventListener('click', (e) => {
  if (e.target.id === 'sell-modal') closeSellModal();
});

loadAll();
loadMarketOverview();</script>

    
<!-- Quick Trade Modal -->
<div id="qt-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:2000;display:none;align-items:center;justify-content:center;" onclick="if(event.target===this)closeQuickTrade()">
  <div style="background:var(--bg-card);border-radius:16px;padding:24px;width:min(380px,90vw);border:1px solid var(--border);">
    <div style="font-weight:800;font-size:16px;margin-bottom:16px;">⚡ 快速模拟交易</div>
    <div style="margin-bottom:12px;">
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:4px;">交易对</div>
      <div id="qt-symbol" style="font-weight:700;font-size:18px;"></div>
      <div id="qt-price" style="color:var(--text-secondary);font-size:13px;margin-top:2px;"></div>
    </div>
    <div style="display:flex;gap:8px;margin-bottom:12px;">
      <button id="qt-buy" onclick="qtSetSide('BUY')" class="tf-btn" style="flex:1;padding:10px;background:#22c55e;color:white;border-color:#22c55e;font-weight:700;">买入</button>
      <button id="qt-sell" onclick="qtSetSide('SELL')" class="tf-btn" style="flex:1;padding:10px;">卖出</button>
    </div>
    <div style="margin-bottom:16px;">
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:4px;">金额 (USDT)</div>
      <input type="number" id="qt-amount" value="100" min="1" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--text-primary);font-size:15px;box-sizing:border-box;">
    </div>
    <button onclick="executeQuickTrade()" style="width:100%;padding:12px;border-radius:10px;background:var(--purple);color:white;font-weight:700;font-size:14px;border:none;cursor:pointer;">确认交易</button>
  </div>
</div>

<!-- Crypto Positions Modal -->
<div id="cp-positions-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:2000;align-items:center;justify-content:center;" onclick="if(event.target===this)this.style.display='none'">
  <div style="background:var(--bg-card);border-radius:16px;padding:20px;width:min(420px,92vw);max-height:70vh;overflow-y:auto;border:1px solid var(--border);">
    <div style="font-weight:800;font-size:15px;margin-bottom:12px;">📋 模拟持仓</div>
    <div id="cp-positions-list"></div>
  </div>
</div>

<!-- Mobile Bottom Navigation -->
    <nav class="mobile-nav" id="mobile-nav">
      <button class="mnav-btn active" data-tab="markets" onclick="mobileTab('markets')"><span>📊</span><small>市场</small></button>
      <button class="mnav-btn" data-tab="paper" onclick="mobileTab('paper')"><span>📈</span><small>模拟</small></button>
      <button class="mnav-btn" data-tab="analysis" onclick="mobileTab('analysis')"><span>🧠</span><small>分析</small></button>
      <button class="mnav-btn" data-tab="binance" onclick="mobileTab('binance')"><span>🏦</span><small>币安</small></button>
      <button class="mnav-btn" data-tab="settings" onclick="mobileTab('settings')"><span>⚙️</span><small>设置</small></button>
    </nav>

    <script>
    // --- Theme Toggle ---
    function toggleTheme() {
      const body = document.documentElement;
      const current = body.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      body.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-toggle').textContent = next === 'dark' ? '☀️' : '🌙';
    }

    // Load saved theme on startup
    (function() {
      const saved = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', saved);
      const btn = document.getElementById('theme-toggle');
      if (btn) btn.textContent = saved === 'dark' ? '☀️' : '🌙';
    })();

    // --- Mobile Tab Navigation ---
    function mobileTab(tab) {
      showTab(tab);
      document.querySelectorAll('.mnav-btn').forEach(b => b.classList.remove('active'));
      document.querySelector(`.mnav-btn[data-tab="${tab}"]`)?.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Register service worker for PWA
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
    </script>

    <!-- Notification Center Panel -->
    <div id="notif-panel" style="display:none;position:fixed;top:60px;right:20px;width:340px;max-height:420px;background:var(--bg-card);border-radius:14px;box-shadow:0 8px 30px rgba(0,0,0,0.15);z-index:300;overflow:hidden;border:1px solid var(--border);">
      <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
        <strong style="font-size:14px;">🔔 通知</strong>
        <button onclick="markAllRead()" style="background:none;border:none;color:var(--purple);font-size:12px;cursor:pointer;">全部已读</button>
      </div>
      <div id="notif-list" style="max-height:360px;overflow-y:auto;"></div>
    </div>

  </body>
</html>
