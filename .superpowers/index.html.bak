// --- Stock K-line Chart ---
let currentStockSymbol = 'sh600519';

async function loadStockKline(symbol) {
  if (symbol) currentStockSymbol = symbol;
  const canvas = document.getElementById('stock-kline');
  if (!canvas) return;
  try {
    const res = await fetch('/api/stock/kline?symbol=' + currentStockSymbol + '&days=60');
    const d = await res.json();
    if (!d.success || !d.data || !d.data.length) return;
    drawStockKline(canvas, d.data);
  } catch(e) {}
}
function drawStockKline(canvas, klines) {
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const W=canvas.width, H=canvas.height;
  const padL=60, padR=10, padT=10, padB=30;
  const chartH=H-padT-padB-20;
  const highs=klines.map(k=>k.high), lows=klines.map(k=>k.low);
  const maxP=Math.max(...highs), minP=Math.min(...lows);
  const range=maxP-minP || 1;
  const cw=(W-padL-padR)/klines.length;
  const green='#22c55e', red='#ef4444';
  klines.forEach((k,idx)=>{
    const x=padL+idx*cw+cw/2;
    const isUp=k.close>=k.open;
    const color=isUp?green:red;
    const yO=padT+chartH-((k.open-minP)/range)*chartH;
    const yC=padT+chartH-((k.close-minP)/range)*chartH;
    ctx.fillStyle=color;
    ctx.fillRect(x-cw/2+1,Math.min(yO,yC),Math.max(cw-2,2),Math.max(1,Math.abs(yC-yO)));
    const yH=padT+chartH-((k.high-minP)/range)*chartH;
    const yL=padT+chartH-((k.low-minP)/range)*chartH;
    ctx.strokeStyle=color;
    ctx.beginPath();ctx.moveTo(x,yH);ctx.lineTo(x,yL);ctx.stroke();
  });
}

