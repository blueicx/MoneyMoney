async function loadHeatmap() {
  const el = document.getElementById('bn-heatmap');
  if (!el) return;
  try {
    const res = await fetch('/api/heatmap');
    const data = await res.json();
    if (!data.success || !data.data?.heatmap) { el.innerHTML = ''; return; }
    el.innerHTML = data.data.heatmap.map(t => {
      const pct = t.changePct || 0;
      const intensity = Math.min(Math.abs(pct) / 5, 1);
      const bg = pct >= 0 ? 'rgba(34,197,94,' + (0.15 + intensity * 0.75) + ')' : 'rgba(239,68,68,' + (0.15 + intensity * 0.75) + ')';
      return '<div class="heat-cell" style="background:' + bg + '" onclick="bnSetSymbol(' + "'" + '+t.symbol+' + "'" + ')" title="' + t.symbol + '">' +
        '<div class="heat-sym">' + t.symbol.replace('USDT','') + '</div>' +
        '<div class="heat-pct">' + (pct>=0?'+':'') + pct.toFixed(2) + '%</div></div>';
    }).join('');
  } catch(e) {}
}

function calcRSI(data, period = 14) {
  if (data.length < period + 1) return [];
  const gains = [], losses = [];
  for (let i = 1; i < data.length; i++) {
    const diff = data[i].close - data[i-1].close;
    gains.push(diff > 0 ? diff : 0);
    losses.push(diff < 0 ? -diff : 0);
  }
  const rsi = new Array(data.length).fill(null);
  let avgGain = gains.slice(0, period).reduce((a,b) => a+b, 0) / period;
  let avgLoss = losses.slice(0, period).reduce((a,b) => a+b, 0) / period;
  rsi[period] = avgLoss === 0 ? 100 : 100 - (100 / (1 + avgGain/avgLoss));
  
  for (let i = period + 1; i < data.length; i++) {
    avgGain = (avgGain * (period-1) + gains[i-1]) / period;
    avgLoss = (avgLoss * (period-1) + losses[i-1]) / period;
    rsi[i] = avgLoss === 0 ? 100 : 100 - (100 / (1 + avgGain/avgLoss));
  }
  return rsi;
}

function drawRSI(canvas, klines) {
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const padL = 60, padR = 10;
  ctx.clearRect(0, 0, W, H);
  
  const rsiValues = calcRSI(klines, 14);
  if (!rsiValues.length) return;
  
  const cs = getComputedStyle(document.documentElement);
  const textColor = cs.getPropertyValue('--text-secondary')?.trim() || '#888';
  const gridColor = cs.getPropertyValue('--border-light')?.trim() || '#333';
  
  // Grid lines at 30, 50, 70
  [30, 50, 70].forEach(level => {
    const y = H - ((level / 100) * (H - 10));
    ctx.strokeStyle = level === 50 ? gridColor : (level >= 70 ? 'rgba(239,68,68,.15)' : level <= 30 ? 'rgba(34,197,94,.15)' : gridColor);
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W-padR, y); ctx.stroke();
    ctx.fillStyle = textColor;
    ctx.font = '9px sans-serif';
    ctx.fillText(String(level), 4, y + 3);
  });
  
  const cw = (W - padL - padR) / klines.length;
  
  // Draw RSI line
  ctx.strokeStyle = '#eab308';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  let started = false;
  rsiValues.forEach((v, i) => {
    if (v === null) return;
    const x = padL + i * cw + cw / 2;
    const y = H - ((v / 100) * (H - 10));
    if (!started) { ctx.moveTo(x, y); started = true; }
    else ctx.lineTo(x, y);
  });
  ctx.stroke();
  ctx.lineWidth = 1;
  
  // Update RSI value display
  const lastRsi = rsiValues[rsiValues.length - 1];
  if (lastRsi !== null) {
    const el = document.getElementById('bn-rsi-value');
    if (el) {
      let color = '#22c55e'; // oversold
      if (lastRsi > 70) color = '#ef4444';
      else if (lastRsi > 50) color = '#f59e0b';
      el.textContent = lastRsi.toFixed(1);
      el.style.color = color;
    }
  }
}


function updateSignalBadge() {
  const rsiVal = document.getElementById('bn-rsi-value')?.textContent;
  if (!rsiVal || rsiVal === '') return;
  const num = parseFloat(rsiVal);
  if (isNaN(num)) return;
  
  const titleEl = document.getElementById('bn-chart-title');
  if (!titleEl) return;
  
  let signalHtml = '';
  if (num <= 30) signalHtml = '<span class="signal-badge signal-buy">买入信号</span>';
  else if (num >= 70) signalHtml = '<span class="signal-badge signal-sell">卖出信号</span>';
  else signalHtml = '<span class="signal-badge signal-neutral">中性</span>';
  
  titleEl.querySelectorAll('.signal-badge').forEach(b => b.remove());
  titleEl.insertAdjacentHTML('beforeend', signalHtml);
}

let bnMtfTimer = null;

function renderMTF(results) {
  const el = document.getElementById('bn-mtf-grid');
  if (!el) return;
  const tfs = ['1m','5m','15m','1h','4h','1d'];
  el.innerHTML = tfs.map(tf => {
    const r = results[tf];
    if (!r) return '<div style="padding:6px 10px;border-radius:8px;background:var(--border-light);font-size:12px;color:var(--text-secondary);">' + tf.toUpperCase() + '</div>';
    const bg = r.trend === 'bullish' ? 'rgba(34,197,94,.15)' : r.trend === 'bearish' ? 'rgba(239,68,68,.15)' : 'var(--border-light)';
    const color = r.trend === 'bullish' ? '#22c55e' : r.trend === 'bearish' ? '#ef4444' : 'var(--text-secondary)';
    const icon = r.trend === 'bullish' ? '▲' : r.trend === 'bearish' ? '▼' : '—';
    return '<div style="padding:6px 10px;border-radius:8px;background:' + bg + ';font-size:12px;">' +
      '<span style="color:var(--text-secondary);margin-right:4px;">' + tf.toUpperCase() + '</span>' +
      '<span style="color:' + color + ';font-weight:700;">' + icon + '</span></div>';
  }).join('');
}

async function loadMTF() {
  const results = {};
  const tfs = ['1m','5m','15m','1h','4h','1d'];
  await Promise.all(tfs.map(async (tf) => {
    try {
      const res = await fetch('/api/binance/klines?symbol=' + bnCurrentSymbol + '&interval=' + tf + '&limit=30');
      const data = await res.json();
      if (!data.success || !data.data?.length) return;
      const klines = data.data;
      // Simple trend: close vs MA7
      const closes = klines.map(k => k.close);
      const ma7 = closes.slice(-7).reduce((a,b) => a+b, 0) / 7;
      const current = closes[closes.length-1];
      results[tf] = { trend: current > ma7 ? 'bullish' : current < ma7 ? 'bearish' : 'neutral', pct: ((current - ma7)/ma7*100).toFixed(2) };
    } catch(e) {}
  }));
  renderMTF(results);
}



function bnFilterSymbols() {
  const query = document.getElementById('bn-search')?.value?.toUpperCase() || '';
  const select = document.getElementById('bn-symbol');
  if (!select) return;
  Array.from(select.options).forEach(opt => {
    opt.style.display = (opt.value.includes(query) || opt.textContent.toUpperCase().includes(query)) ? '' : 'none';
  });
}


async function loadAlertsForChart() {
  try {
    const res = await fetch('/api/alerts');
    const data = await res.json();
    if (data.success && data.data) {
      bnActiveAlerts = data.data.filter(a => !a.triggered && a.symbol === bnCurrentSymbol)
        .map(a => ({ price: parseFloat(a.price), direction: a.direction }));
    } else { bnActiveAlerts = []; }
  } catch(e) { bnActiveAlerts = []; }
}


// --- Quick Trade ---
let qtSide = 'BUY';
let qtSymbol = '';

function openQuickTrade(symbol) {
  qtSymbol = symbol || bnCurrentSymbol;
  document.getElementById('qt-symbol').textContent = qtSymbol.replace('USDT','/USDT');
  fetch('/api/binance/price/' + qtSymbol).then(r=>r.json()).then(d => {
    if (d.success && d.data) document.getElementById('qt-price').textContent = '$' + d.data.price.toFixed(2);
  }).catch(()=>{});
  qtSetSide('BUY');
  document.getElementById('qt-modal').style.display = 'flex';
}
function closeQuickTrade() { document.getElementById('qt-modal').style.display = 'none'; }
function qtSetSide(s) {
  qtSide = s;
  document.getElementById('qt-buy').classList.toggle('qt-active-buy', s==='BUY');
  document.getElementById('qt-sell').classList.toggle('qt-active-sell', s==='SELL');
}
async function executeQuickTrade() {
  const amount = parseFloat(document.getElementById('qt-amount')?.value) || 0;
  if (amount <= 0) { showToast('请输入有效金额','error'); return; }
  try {
    const res = await fetch('/api/binance/paper-trade', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ symbol: qtSymbol, side: qtSide, amountUsd: amount })
    });
    const d = await res.json();
    if (d.success) {
      showToast('✔ ' + (qtSide==='BUY'?'买入':'卖出') + ' ' + qtSymbol + ' $' + amount, 'success');
      closeQuickTrade();
    } else showToast(d.message || '失败', 'error');
  } catch(e) { showToast('连接失败', 'error'); }
}

async function showCryptoPositions() {
  try {
    const res = await fetch('/api/binance/paper-positions');
    const d = await res.json();
    const listEl = document.getElementById('cp-positions-list');
    if (!listEl) return;
    if (!d.success || !d.data?.length) { listEl.innerHTML = '<div style="color:var(--text-secondary);text-align:center;padding:20px;">暂无持仓</div>'; }
    else {
      listEl.innerHTML = d.data.map(p => {
        const pnlCls = p.pnl >= 0 ? 'bn-up' : 'bn-down';
        return '<div style="padding:10px;border-bottom:1px solid var(--border-light);">' +
          '<div style="display:flex;justify-content:space-between;"><span style="font-weight:700;">' + p.symbol.replace('USDT','') + '</span>' +
          '<span class="' + pnlCls + '" style="font-weight:700;">' + (p.pnl>=0?'+':'') + '$' + p.pnl.toFixed(2) + '</span></div>' +
          '<div style="font-size:11px;color:var(--text-secondary);margin-top:4px;">' + p.side + ' @ $' + p.entryPrice.toFixed(2) + ' → $' + p.currentPrice?.toFixed(2) + ' | $' + p.amountUsd + '</div></div>';
      }).join('');
    }
    document.getElementById('cp-positions-modal').style.display = 'flex';
  } catch(e) {}
}


// --- Watchlist / Favorites ---
let bnFavorites = JSON.parse(localStorage.getItem('bnFavorites') || '[]');

function toggleFavorite(sym) {
  event.stopPropagation();
  if (bnFavorites.includes(sym)) {
    bnFavorites = bnFavorites.filter(s => s !== sym);
    showToast(sym.replace('USDT','') + ' 已从自选中移除', 'info');
  } else {
    bnFavorites.push(sym);
    showToast('⭐ ' + sym.replace('USDT','') + ' 已加入自选', 'success');
  }
  localStorage.setItem('bnFavorites', JSON.stringify(bnFavorites));
  loadBinancePrices(); // Re-render with new sort
}

function isFavorite(sym) { return bnFavorites.includes(sym); }


async function loadPortfolioSummary() {
  const el = document.getElementById('cp-summary');
  if (!el) return;
  try {
    const res = await fetch('/api/binance/paper-positions');
    const d = await res.json();
    if (!d.success || !d.data || !d.data.length) { el.innerHTML = ''; return; }
    const positions = d.data;
    const totalPnl = positions.reduce((sum, p) => sum + (p.pnl || 0), 0);
    const wins = positions.filter(p => p.pnl > 0).length;
    const winRate = Math.round((wins / positions.length) * 100);
    el.innerHTML =
      '<div style="grid-column:1/-1;font-weight:700;font-size:13px;">\u{1F4CA} \u6A21\u62DF\u4EA4\u6613</div>' +
      '<div style="background:var(--bg-card);border-radius:10px;padding:10px;border:1px solid var(--border);">' +
      '<div style="font-size:11px;color:var(--text-secondary);">\u6301\u4ED3</div>' +
      '<div style="font-size:16px;font-weight:800;">' + positions.length + '</div></div>' +
      '<div style="background:var(--bg-card);border-radius:10px;padding:10px;border:1px solid var(--border);">' +
      '<div style="font-size:11px;color:var(--text-secondary);">\u603B\u76C8\u4E8F</div>' +
      '<div style="font-size:16px;font-weight:800;color:' + (totalPnl >= 0 ? '#22c55e' : '#ef4444') + ';">$' + totalPnl.toFixed(2) + '</div></div>' +
      '<div style="background:var(--bg-card);border-radius:10px;padding:10px;border:1px solid var(--border);">' +
      '<div style="font-size:11px;color:var(--text-secondary);">\u80DC\u7387</div>' +
      '<div style="font-size:16px;font-weight:800;">' + winRate + '%</div></div>';
  } catch(e) {}
}


// --- Chart Hover Crosshair + Tooltip ---
(function initChartHover() {
  const canvas = document.getElementById('bn-candlestick');
  if (!canvas) return;
  let overlayCanvas = null;
  
  function getOverlay() {
    if (overlayCanvas) return overlayCanvas;
    overlayCanvas = document.createElement('canvas');
    overlayCanvas.width = canvas.width;
    overlayCanvas.height = canvas.height;
    overlayCanvas.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:auto;pointer-events:none;';
    canvas.parentElement.style.position = 'relative';
    canvas.parentElement.appendChild(overlayCanvas);
    return overlayCanvas;
  }
  
  function clearOverlay() { 
    const oc = getOverlay(); 
    const ctx = oc.getContext('2d'); 
    ctx.clearRect(0, 0, oc.width, oc.height); 
    document.getElementById('bn-hover-tip').style.display = 'none';
  }
  
  function drawCrosshair(x, y) {
    const oc = getOverlay();
    const ctx = oc.getContext('2d');
    ctx.clearRect(0, 0, oc.width, oc.height);
    
    // Crosshair lines
    ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary')?.trim() || '#888';
    ctx.setLineDash([4,4]);
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, oc.height); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(60, y); ctx.lineTo(oc.width-10, y); ctx.stroke();
    ctx.setLineDash([]);
  }
  
  function showTip(candleIdx, mouseX, mouseY) {
    if (!bnKlineData || !bnKlineData[candleIdx]) return;
    const k = bnKlineData[candleIdx];
    const isUp = k.close >= k.open;
    const color = isUp ? '#22c55e' : '#ef4444';
    const arrow = isUp ? '↑' : '↓';
    
    const tip = document.getElementById('bn-hover-tip');
    if (!tip) return;
    
    const time = new Date(k.time);
    const timeStr = time.toLocaleDateString('zh-CN',{month:'short',day:'numeric'}) + ' ' + 
                    time.toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit',hour12:false});
    
    tip.innerHTML = 
      '<div style="font-weight:700;margin-bottom:4px;">' + timeStr + '</div>' +
      '<div><span style="color:var(--text-secondary);">\u5F00</span> <span style="font-weight:600;">$' + k.open.toFixed(k.open>100?1:4) + '</span></div>' +
      '<div><span style="color:var(--text-secondary);">\u9AD8</span> <span style="font-weight:600;">$' + k.high.toFixed(k.high>100?1:4) + '</span></div>' +
      '<div><span style="color:var(--text-secondary);">\u4F4E</span> <span style="font-weight:600;">$' + k.low.toFixed(k.low>100?1:4) + '</span></div>' +
      '<div><span style="color:var(--text-secondary);">\u6536</span> <span style="font-weight:600;color:' + color + ';">' + arrow + '$' + k.close.toFixed(k.close>100?1:4) + '</span></div>' +
      '<div><span style="color:var(--text-secondary);">\u91CF</span> <span>' + (k.volume/1000).toFixed(1) + 'K</span></div>';
    
    tip.style.display = 'block';
    
    // Position near cursor but keep in bounds
    const container = canvas.parentElement;
    const rect = container.getBoundingClientRect();
    let left = mouseX + 15;
    if (left + 140 > rect.width) left = mouseX - 150;
    tip.style.left = Math.max(0,left) + 'px';
    tip.style.top = Math.max(0,mouseY - 40) + 'px';
  }
  
  canvas.addEventListener('mousemove', (e) => {
    if (!bnKlineData?.length) return;
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const x = (e.clientX - rect.left) * scaleX;
    const y = (e.clientY - rect.top) * (canvas.height / rect.height);
    
    const padL = 60, padR = 10;
    if (x < padL || x > canvas.width - padR) { clearOverlay(); return; }
    
    const cw = (canvas.width - padL - padR) / bnKlineData.length;
    const idx = Math.floor((x - padL) / cw);
    if (idx < 0 || idx >= bnKlineData.length) { clearOverlay(); return; }
    
    drawCrosshair(x, y);
    
    const relX = e.clientX - rect.left;
    const relY = e.clientY - rect.top;
    showTip(idx, relX, relY);
  });
  
  canvas.addEventListener('mouseleave', () => clearOverlay());
})();


