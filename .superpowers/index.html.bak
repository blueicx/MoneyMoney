      const cls = d.data.change24hPct >= 0 ? 'bn-up' : 'bn-down';
      chips.push('<div class="ov-chip"><span class="ov-label">BTC</span><span class="ov-value">$' + Math.round(d.data.price).toLocaleString() + '</span><span class="ov-change ' + cls + '">' + (d.data.change24hPct>=0?'+':'') + d.data.change24hPct.toFixed(1) + '%</span></div>');
    }
  } catch(e) {}
  try {
    const r = await fetch('/api/sentiment');
    const d = await r.json();
    if (d.success && d.data && d.data.length) {
      const val = parseInt(d.data[0].value);
      chips.push('<div class="ov-chip"><span class="ov-label">F&G</span><span class="ov-value" style="color:#eab308;">' + val + '</span></div>');
    }
  } catch(e) {}
  try {
    const r = await fetch('/api/defi/tvl');
    const d = await r.json();
    if (d.success && d.data && d.data.length) {
      chips.push('<div class="ov-chip"><span class="ov-label">DeFi TVL</span><span class="ov-value">$' + (d.data[d.data.length-1].tvl/1e9).toFixed(0) + 'B</span></div>');
    }
  } catch(e) {}
  el.innerHTML = chips.join('') || '';
}


// --- News Ticker ---
(async function loadNewsTicker() {
  try {
    const res = await fetch('/api/crypto-news');
    const d = await res.json();
    if (!d.success || !d.data || !d.data.length) return;
    const el = document.getElementById('ticker-content');
    if (!el) return;
    // Duplicate items for seamless loop
    const items = [...d.data, ...d.data];
    el.innerHTML = items.map(function(item) {
      return '<span class="ticker-item" onclick="event.stopPropagation();window.open(\'' + item.link + '\',\'_blank\')">\u{1F4F0} ' + item.title + '</span>';
    }).join('');
  } catch(e) {}
})();

// --- Auto Refresh ---
let bnAutoRefreshTimer = null;
let bnActiveAlerts = [];
function toggleAutoRefresh() {
  const btn = document.getElementById('bn-auto-refresh');
  if (!btn) return;
  if (bnAutoRefreshTimer) {
    clearInterval(bnAutoRefreshTimer);
    bnAutoRefreshTimer = null;
    btn.classList.remove('active');
    btn.textContent = '⏱ 自动刷新: 关';
  } else {
    bnAutoRefreshTimer = setInterval(() => {
      loadBinancePrices();
      loadBinanceDepth();
      loadBinanceTrades();
    }, 30000); // Every 30 seconds
    btn.classList.add('active');
    btn.textContent = '⏱ 自动刷新: 开';
  }
}

function exportKlineCSV() {
  if (!bnKlineData || !bnKlineData.length) { showToast('\u6CA1\u6709\u6570\u636E', 'warning'); return; }
  let csv = '\u65F6\u95F4,\u5F00\u76D8\u4EF7,\u6700\u9AD8\u4EF7,\u6700\u4F4E\u4EF7,\u6536\u76D8\u4EF7,\u6210\u4EA4\u91CF\\n';
  bnKlineData.forEach(k => {
    const time = new Date(k.time).toLocaleString('zh-CN');
    csv += time + ',' + k.open + ',' + k.high + ',' + k.low + ',' + k.close + ',' + k.volume + '\\n';
  });
  const blob = new Blob(['\\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = bnCurrentSymbol + '_' + bnCurrentInterval + '_klines.csv';
  a.click();
  showToast('CSV \u5DF2\u5BFC\u51FA', 'success');
}




