// --- Alerts ---
async function loadAlerts() {
  try {
    const res = await fetch('/api/alerts');
    const { data: alerts } = await res.json();
    const el = document.getElementById('alerts-list');
    if (!alerts || alerts.length === 0) {
      el.innerHTML = "<div style=\"color:var(--text-secondary);font-size:13px;\">\u6682\u65E0\u9884\u8B66\uFF1B\u53EF\u5728\u4E0A\u65B9\u6DFB\u52A0\u3002</div>";
      return;
    }
    el.innerHTML = alerts.map((a) => `
          <div style="background:var(--bg-card);border-radius:10px;padding:12px 14px;margin-bottom:8px;box-shadow:var(--shadow);display:flex;justify-content:space-between;align-items:center;font-size:13px;">
            <div>
              <strong>${a.symbol}</strong> ${a.direction === 'ABOVE' ? "\u2B06\uFE0F \u9AD8\u4E8E" : "\u2B07\uFE0F \u4F4E\u4E8E"} $${a.targetPrice}
              ${a.triggered ? "<span style=\"color:var(--green);margin-left:8px;\">\u2713 \u5DF2\u89E6\u53D1</span>" : ''}
            </div>
            <button onclick="removeAlert('${a.id}')" style="background:none;border:none;cursor:pointer;font-size:16px;">🗑</button>
          </div>`).join('');
  } catch (e) {}
}

async function addAlert() {
  const symbol = document.getElementById('alert-symbol').value.trim().toUpperCase();
  const direction = document.getElementById('alert-direction').value;
  const price = parseFloat(document.getElementById('alert-price').value);
  if (!symbol || !price) {alert("\u8BF7\u586B\u5199\u6240\u6709\u5B57\u6BB5");return;}
  await fetch('/api/alerts/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ symbol, targetPrice: price, direction }) });
  document.getElementById('alert-symbol').value = '';
  document.getElementById('alert-price').value = '';
  loadAlerts();
}

async function removeAlert(id) {
  await fetch('/api/alerts/remove', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
  loadAlerts();
}

// --- Whales ---
async function loadWhales() {
  const loading = document.getElementById('whales-loading');
  const listEl = document.getElementById('whales-list');
  loading.style.display = 'block';
  listEl.innerHTML = '';
  try {
    const res = await fetch('/api/whales?threshold=1000000');
    const { data: txs } = await res.json();
    loading.style.display = 'none';
    if (!txs || txs.length === 0) {
      listEl.innerHTML = "<div style=\"color:var(--text-secondary);\">\u5F53\u524D\u6CA1\u6709\u7B26\u5408\u6761\u4EF6\u7684\u5DE8\u9CB8\u8F6C\u8D26\u3002</div>";
      return;
    }
    listEl.innerHTML = txs.map((t) => `
          <div style="background:var(--bg-card);border-radius:10px;padding:12px 14px;margin-bottom:8px;box-shadow:var(--shadow);display:flex;justify-content:space-between;font-size:13px;">
            <div>
              <div style="font-weight:600;">🐋 $${t.usdValue.toLocaleString()}</div>
              <div style="color:var(--text-secondary);font-size:11px;">${t.amountBtc} BTC · ${new Date(t.time).toLocaleTimeString()}</div>
            </div>
            <a href="https://www.blockchain.com/btc/tx/${t.hash}" target="_blank" style="color:var(--purple);font-size:11px;align-self:center;">查看 ↗</a>
          </div>`).join('');
  } catch (e) {
    loading.style.display = 'none';
    listEl.innerHTML = "<div style=\"color:var(--red);\">\u5DE8\u9CB8\u6570\u636E\u52A0\u8F7D\u5931\u8D25</div>";
  }
}

