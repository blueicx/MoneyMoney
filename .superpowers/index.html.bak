// --- Binance Dashboard ---
let bnCurrentSymbol = 'BTCUSDT';
let bnCurrentInterval = '15m';
let bnKlineData = [];

function bnSetSymbol(sym) {
  bnCurrentSymbol = sym;
  document.getElementById('bn-symbol').value = sym;
  loadBinanceDashboard();
}
function bnSetInterval(iv) {
  bnCurrentInterval = iv;
  document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  loadBinanceKlines();
