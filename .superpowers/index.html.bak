async function loadDefiTvl() {
  const el = document.getElementById('defi-tvl-card');
  if (!el) return;
  try {
    const res = await fetch('/api/defi/tvl');
    const d = await res.json();
    if (!d.success || !d.data?.length) { el.innerHTML = ''; return; }
    
    const latest = d.data[d.data.length-1];
    const prev = d.data[d.data.length-2] || latest;
    const changePct = prev.tvl ? ((latest.tvl - prev.tvl) / prev.tvl * 100).toFixed(2) : '0';
    const tvlB = (latest.tvl / 1e9).toFixed(1);
    const cls = parseFloat(changePct) >= 0 ? 'bn-up' : 'bn-down';
    
    el.innerHTML =
      '<div class="idx-card" style="min-width:160px;">' +
      '<div class="idx-name">全球 DeFi TVL</div>' +
      '<div class="idx-price">$' + tvlB + 'B</div>' +
      '<div class="idx-change ' + cls + '">' + (parseFloat(changePct)>=0?'▲':'▼') + ' ' + Math.abs(parseFloat(changePct)).toFixed(2) + '% (日变)</div></div>';
