}

async function loadBinancePrices() {
  const el = document.getElementById('binance-prices');
  if (!el) return;
  // Show skeleton while loading
  el.innerHTML = Array(6).fill('<div class="skl skl-card"><div class="skl-line"></div><div class="skl-line w60"></div><div class="skl-line w40"></div></div>').join('');
  let symbols = ['BTCUSDT','ETHUSDT','BNBUSDT','SOLUSDT','XRPUSDT','DOGEUSDT'];
  // Sort favorites first
  if (bnFavorites.length) {
    const favs = symbols.filter(s => bnFavorites.includes(s));
    const rest = symbols.filter(s => !bnFavorites.includes(s));
    // Also add any favorites not in default list
    bnFavorites.forEach(f => { if (!symbols.includes(f)) favs.unshift(f); });
    symbols = [...new Set([...favs, ...rest])];
  }
  try {
    const res = await fetch('/api/binance/prices?symbols=' + symbols.join(','));
    const data = await res.json();
    if (!data.success || !data.data) { el.innerHTML = '<div style="color:var(--text-secondary);grid-column:1/-1;">加载失败</div>'; return; }
    let h = '';
    for (const [sym, t] of Object.entries(data.data)) {
      if (!t) continue;
      const cls = t.change24hPct >= 0 ? 'bn-up' : 'bn-down';
      const arrow = t.change24hPct >= 0 ? '▲' : '▼';
      h += '<div class="bn-tick-card" onclick="bnSetSymbol(\'' + sym + '\')" style="cursor:pointer;">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;"><span class="bn-tick-sym">' + sym.replace('USDT','') + '</span>' +
        '<span style="display:flex;gap:4px;">' +
        '<button onclick="toggleFavorite(\'' + sym + '\')" style="padding:2px 5px;border:none;background:none;font-size:12px;cursor:pointer;">' + (isFavorite(sym) ? '⭐' : '☆') + '</button>' +
        '<button onclick="event.stopPropagation();openQuickTrade(\'' + sym + '\')" style="padding:2px 6px;border-radius:4px;border:none;background:var(--purple);color:white;font-size:9px;cursor:pointer;">⚡</button></span></div>' +
        '<div class="bn-tick-price">$' + (t.price >= 100 ? t.price.toFixed(0) : t.price.toFixed(2)) + '</div>' +
        '<div class="bn-tick-change ' + cls + '">' + arrow + ' ' + Math.abs(t.change24hPct).toFixed(2) + '%</div></div>';
    }
    el.innerHTML = h;
  } catch(e) {
    el.innerHTML = '<div class="empty-tip"><div class="empty-tip-icon">⚠️</div>加载失败<button class="tf-btn" onclick="loadBinancePrices()" style="margin-left:8px;">重试</button></div>';
  }
}

function drawCandles(canvas, klines) {
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const padL = 60, padR = 10, padT = 10, padB = 50;
  const chartH = H - padT - padB - 40; // leave room for volume
  const volTop = padT + chartH + 20;
  const volH = 30;

  const cs = getComputedStyle(document.documentElement);
  const textColor = cs.getPropertyValue('--text-secondary')?.trim() || '#888';
  const green = '#22c55e', red = '#ef4444';

  ctx.clearRect(0, 0, W, H);
  if (!klines.length) return;

  const highs = klines.map(k => k.high), lows = klines.map(k => k.low);
  const maxP = Math.max(...highs), minP = Math.min(...lows);
  const range = maxP - minP || 1;
  const maxV = Math.max(...klines.map(k => k.volume)) || 1;
  const cw = (W - padL - padR) / klines.length;

  // Price grid lines
  ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--border-light') || '#333';
  ctx.fillStyle = textColor;
  ctx.font = '10px sans-serif';
  for (let g = 0; g <= 4; g++) {
    const y = padT + (chartH / 4) * g;
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
    ctx.fillText((maxP - (range / 4) * g).toFixed(maxP > 1000 ? 0 : 2), 4, y + 4);
  }

  // Candles + volume
  klines.forEach((k, idx) => {
    const x = padL + idx * cw + cw / 2;
    const isUp = k.close >= k.open;
    const color = isUp ? green : red;
    // Candle body
    const yO = padT + chartH - ((k.open - minP) / range) * chartH;
    const yC = padT + chartH - ((k.close - minP) / range) * chartH;
    const bodyH = Math.max(1, Math.abs(yC - yO));
    ctx.fillStyle = color;
    ctx.fillRect(x - cw / 2 + 1, Math.min(yO, yC), Math.max(cw - 2, 2), bodyH);
    // Wick
    const yH = padT + chartH - ((k.high - minP) / range) * chartH;
    const yL = padT + chartH - ((k.low - minP) / range) * chartH;
    ctx.strokeStyle = color;
    ctx.beginPath(); ctx.moveTo(x, yH); ctx.lineTo(x, yL); ctx.stroke();
    // Volume bar
    const vh = (k.volume / maxV) * volH;
    ctx.globalAlpha = 0.3;
    ctx.fillRect(x - cw / 2 + 1, volTop + volH - vh, Math.max(cw - 2, 2), vh);
    ctx.globalAlpha = 1;
  });

  // MA lines
  function calcMA(data, period) {
    return data.map((_, i) => {
      if (i < period - 1) return null;
      let sum = 0;
      for (let j = i - period + 1; j <= i; j++) sum += data[j].close;
      return sum / period;
    });
  }
  
  function drawMALine(maValues, color) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    let started = false;
    maValues.forEach((v, i) => {
      if (v === null) return;
      const x = padL + i * cw + cw / 2;
      const y = padT + chartH - ((v - minP) / range) * chartH;
      if (!started) { ctx.moveTo(x, y); started = true; }
      else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.lineWidth = 1;
  }
  
  drawMALine(calcMA(klines, 7), '#f59e0b');
  drawMALine(calcMA(klines, 25), '#8b5cf6');
  
  // Bollinger Bands
  const bb = calcBollinger(klines, 20, 2);
  function drawBandLine(values, color, dash) {
    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    if (dash) ctx.setLineDash([4, 3]);
    ctx.beginPath();
    let started = false;
    values.forEach((v, i) => {
      if (v === null) return;
      const x = padL + i * cw + cw / 2;
      const y = padT + chartH - ((v - minP) / range) * chartH;
      if (!started) { ctx.moveTo(x, y); started = true; }
      else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }
  drawBandLine(bb.upper, 'rgba(59,130,246,.5)');
  drawBandLine(bb.middle, 'rgba(156,163,175,.4)', true);
  drawBandLine(bb.lower, 'rgba(59,130,246,.5)');

  // Legend
  ctx.font = '10px sans-serif';
  ctx.fillStyle = '#f59e0b';
  ctx.fillText('MA7', padL + 5, padT + 12);
  ctx.fillStyle = '#8b5cf6';
  ctx.fillText('MA25', padL + 40, padT + 12);


function calcBollinger(data, period = 20, multiplier = 2) {
  const result = { upper: [], middle: [], lower: [] };
  if (data.length < period) return result;
  
  for (let i = 0; i < data.length; i++) {
    if (i < period - 1) {
      result.upper.push(null);
      result.middle.push(null);
      result.lower.push(null);
      continue;
    }
    const slice = data.slice(i - period + 1, i + 1).map(k => k.close);
    const sma = slice.reduce((a, b) => a + b, 0) / period;
    const variance = slice.reduce((sum, v) => sum + Math.pow(v - sma, 2), 0) / period;
    const stdDev = Math.sqrt(variance);
    
    result.middle.push(sma);
    result.upper.push(sma + multiplier * stdDev);
    result.lower.push(sma - multiplier * stdDev);
  }
  return result;
}


  
  // Current price line (dashed white/gold)
  if (klines.length > 0) {
    const lastPrice = klines[klines.length-1].close;
    if (lastPrice >= minP && lastPrice <= maxP) {
      const y = padT + chartH - ((lastPrice - minP) / range) * chartH;
      ctx.strokeStyle = '#f59e0b';
      ctx.setLineDash([4, 4]);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
      ctx.setLineDash([]);
      // Price tag on right side
      ctx.fillStyle = '#f59e0b';
      ctx.font = 'bold 10px sans-serif';
      const priceLabel = lastPrice.toFixed(maxP > 1000 ? 0 : 2);
      const labelWidth = ctx.measureText(priceLabel).width + 8;
      ctx.fillRect(W - padR - labelWidth, y - 7, labelWidth, 14);
      ctx.fillStyle = '#000';
      ctx.fillText(priceLabel, W - padR - labelWidth + 4, y + 4);
    }
  }

  // Support/Resistance auto-detection
  if (klines.length >= 20) {
    const lookback = 5; // Bars on each side to confirm a swing point
    const supports = [];
    const resistances = [];
    
    for (let i = lookback; i < klines.length - lookback; i++) {
      let isHigh = true, isLow = true;
      for (let j = i - lookback; j <= i + lookback; j++) {
        if (j === i) continue;
        if (klines[j].high >= klines[i].high) isHigh = false;
        if (klines[j].low <= klines[i].low) isLow = false;
      }
      if (isHigh) resistances.push(klines[i].high);
      if (isLow) supports.push(klines[i].low);
    }
    
    // Cluster nearby levels and draw strongest ones
    function clusterLevels(levels, tolerance) {
      if (!levels.length) return [];
      levels.sort((a,b) => a-b);
      const clusters = [[levels[0]]];
      for (let i = 1; i < levels.length; i++) {
        if (Math.abs(levels[i] - clusters[clusters.length-1][0]) <= tolerance) {
          clusters[clusters.length-1].push(levels[i]);
        } else {
          clusters.push([levels[i]]);
        }
      }
      return clusters.map(c => c.reduce((a,b)=>a+b,0)/c.length).slice(-3); // Top 3
    }
    
    const tolerance = range * 0.01;
    const supLevels = clusterLevels(supports, tolerance);
    const resLevels = clusterLevels(resistances, tolerance);
    
    // Draw support lines (green dashed)
    supLevels.forEach(level => {
      const y = padT + chartH - ((level - minP) / range) * chartH;
      ctx.strokeStyle = 'rgba(34,197,94,.4)';
      ctx.setLineDash([8, 6]);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
      ctx.fillStyle = 'rgba(34,197,94,.7)';
      ctx.font = '9px sans-serif';
      ctx.fillText('S', padL + 2, y - 2);
    });
    
    // Draw resistance lines (red dashed)
    resLevels.forEach(level => {
      const y = padT + chartH - ((level - minP) / range) * chartH;
      ctx.strokeStyle = 'rgba(239,68,68,.4)';
      ctx.setLineDash([8, 6]);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
      ctx.fillStyle = 'rgba(239,68,68,.7)';
      ctx.font = '9px sans-serif';
      ctx.fillText('R', padL + 2, y + 10);
    });
    ctx.setLineDash([]);
  }

  // Price Alert Lines
  if (typeof bnActiveAlerts !== 'undefined' && bnActiveAlerts.length > 0) {
    bnActiveAlerts.forEach(alert => {
      if (alert.price < minP || alert.price > maxP) return;
      const y = padT + chartH - ((alert.price - minP) / range) * chartH;
      const color = alert.direction === 'ABOVE' ? '#ef4444' : '#22c55e';
      ctx.strokeStyle = color;
      ctx.setLineDash([6, 4]);
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
      ctx.setLineDash([]);
      // Label
      ctx.fillStyle = color;
      ctx.font = 'bold 10px sans-serif';
      const label = (alert.direction === 'ABOVE' ? '↑' : '↓') + ' ' + alert.price.toFixed(maxP > 1000 ? 0 : 2);
      ctx.fillText(label, W - padR - ctx.measureText(label).width - 5, y - 3);
    });
  }

  // Time labels

  ctx.fillStyle = textColor;
  const labelStep = Math.max(1, Math.floor(klines.length / 6));
  klines.forEach((k, idx) => {
    if (idx % labelStep !== 0) return;
    const d = new Date(k.time);
    const lbl = d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
    const x = padL + idx * cw + cw / 2;
    ctx.fillText(lbl, x - 14, H - 25);
  });
}

async function loadBinanceKlines() {
  const titleEl = document.getElementById('bn-chart-title');
  const canvas = document.getElementById('bn-candlestick');
  if (!canvas) return;
  if (titleEl) {
      titleEl.textContent = bnCurrentSymbol.replace('USDT','/USDT') + ' · ' + bnCurrentInterval.toUpperCase();
    }
  try {
    const res = await fetch('/api/binance/klines?symbol=' + bnCurrentSymbol + '&interval=' + bnCurrentInterval + '&limit=80');
    const data = await res.json();
    if (!data.success) { 
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0,0,canvas.width,canvas.height);
      return;
    }
    bnKlineData = data.data;
    drawCandles(canvas, bnKlineData);
    const rsiCanvas = document.getElementById('bn-rsi');
    if (rsiCanvas) {
      drawRSI(rsiCanvas, bnKlineData);
      updateSignalBadge();
      const macdCanvas = document.getElementById('bn-macd');
      if (macdCanvas) drawMACD(macdCanvas, bnKlineData);
    }
    loadAlertsForChart().then(() => drawCandles(canvas, bnKlineData));
  } catch(e) {}
}

async function loadBinanceDepth() {
  const el = document.getElementById('bn-depth');
  if (!el) return;
  try {
    const res = await fetch('/api/binance/depth?symbol=' + bnCurrentSymbol + '&limit=10');
    const data = await res.json();
    if (!data.success || !data.data) { el.innerHTML = '<div style="color:var(--text-secondary);font-size:12px;">暂无数据</div>'; return; }
    const { bids, asks } = data.data;
    const maxQty = Math.max(...bids.map(b => b[1]), ...asks.map(a => a[1]));
    
    let h = '';
    // Asks (sell orders, highest first)
    [...asks].reverse().slice(0, 5).forEach(([p, q]) => {
      const w = (q / maxQty * 100).toFixed(0);
      h += '<div class="depth-row"><span style="color:#ef4444;">' + p.toFixed(p>100?1:4) + '</span><span>' + q.toFixed(3) + '</span><div style="position:absolute;right:0;top:0;height:100%;width:'+w+'%;background:rgba(239,68,68,.08);"></div></div>';
    });
    // Spread
    if (asks.length && bids.length) {
      const spread = asks[0][0] - bids[0][0];
      h += '<div style="text-align:center;font-size:11px;font-weight:700;padding:4px 0;color:var(--text-primary);border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin:2px 0;">' + asks[0][0].toFixed(2) + '</div>';
    }
    // Bids
    bids.slice(0, 5).forEach(([p, q]) => {
      h += '<div class="depth-row"><span style="color:#22c55e;">' + p.toFixed(p>100?1:4) + '</span><span>' + q.toFixed(3) + '</span></div>';
    });
    el.innerHTML = h;
    
    // Draw depth area chart
    drawDepthChart(bids, asks);
  } catch(e) {}
}

function drawDepthChart(bids, asks) {
  const canvas = document.getElementById('bn-depth-chart');
  if (!canvas || !bids?.length || !asks?.length) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);
  
  // Calculate cumulative volumes
  let cumBid = 0;
  const bidPoints = bids.map(([p, q]) => ({ p, cum: cumBid += q }));
  let cumAsk = 0;
  const askPoints = asks.map(([p, q]) => ({ p, cum: cumAsk += q })).reverse();
  
  const maxCum = Math.max(cumBid, cumAsk);
  const minP = asks[asks.length-1][0], maxP = bids[0][0];
  const range = maxP - minP || 1;
  
  // Draw bid area (green)
  ctx.fillStyle = 'rgba(34,197,94,.25)';
  ctx.beginPath();
  ctx.moveTo(W/2, H);
  bidPoints.forEach(pt => {
    const x = W/2 + ((maxP - pt.p) / range) * (W/2);
    const y = H - (pt.cum / maxCum) * (H - 10);
    ctx.lineTo(x, y);
  });
  ctx.lineTo(W, H);
  ctx.closePath();
  ctx.fill();
  
  // Draw ask area (red)
  ctx.fillStyle = 'rgba(239,68,68,.25)';
  ctx.beginPath();
  ctx.moveTo(W/2, H);
  askPoints.forEach(pt => {
    const x = W/2 - ((pt.p - minP) / range) * (W/2);
    const y = H - (pt.cum / maxCum) * (H - 10);
    ctx.lineTo(x, y);
  });
  ctx.lineTo(0, H);
  ctx.closePath();
  ctx.fill();
  
  // Mid line
  ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--border')?.trim() || '#555';
  ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(W/2, 0); ctx.lineTo(W/2, H); ctx.stroke();
  ctx.setLineDash([]);
}

async function loadBinanceTrades() {
  const el = document.getElementById('bn-trades');
  if (!el) return;
  try {
    const res = await fetch('/api/binance/trades?symbol=' + bnCurrentSymbol + '&limit=10');
    const data = await res.json();
    if (!data.success || !data.data?.length) { el.innerHTML = '<div style="color:var(--text-secondary);font-size:12px;">暂无数据</div>'; return; }
    let h = data.data.reverse().map(t => {
      const cls = t.isBuyerMaker ? 'bn-down' : 'bn-up';
      const side = t.isBuyerMaker ? '卖' : '买';
      const time = new Date(t.time).toLocaleTimeString('zh-CN',{hour12:false});
      return '<div class="trade-row"><span class="' + cls + '" style="font-weight:600;">' + side + '</span><span>' + t.price.toFixed(t.price>100?1:4) + '</span><span>' + t.qty.toFixed(4) + '</span><span style="color:var(--text-secondary);">' + time + '</span></div>';
    }).join('');
    el.innerHTML = h;
  } catch(e) {}
}

async function loadMovers() {
  try {
    const res = await fetch('/api/binance/movers');
    const data = await res.json();
    if (!data.success || !data.data) return;
    const { gainers, losers } = data.data;
    
    const renderList = (items) => items.map(t => 
      '<div class="mover-row"><span style="font-weight:600;">' + t.symbol.replace('USDT','') + '</span>' +
      '<span>$' + (t.price>=100?t.price.toFixed(0):t.price.toFixed(4)) + '</span>' +
      '<span class="' + (t.changePct>=0?'bn-up':'bn-down') + '" style="font-weight:700;">' + (t.changePct>=0?'+':'') + t.changePct.toFixed(2) + '%</span></div>'
    ).join('');
    
    const gEl = document.getElementById('bn-gainers');
    const lEl = document.getElementById('bn-losers');
    if (gEl) gEl.innerHTML = renderList(gainers) || '<div style="font-size:12px;color:var(--text-secondary);">暂无数据</div>';
    if (lEl) lEl.innerHTML = renderList(losers) || '<div style="font-size:12px;color:var(--text-secondary);">暂无数据</div>';
  } catch(e) {}
}
