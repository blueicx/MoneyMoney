app.get('/api/macro/stablecoins', async (req, res) => {
  try {
    const cached = getCached('stablecoins');
    if (cached) return res.json({ success: true, data: cached });
    const response = await fetch('https://stablecoins.llama.fi/stablecoins?includePrices=false', {
      signal: AbortSignal.timeout(15000)
    });
    if (!response.ok) throw new Error('API failed');
    const json: any = await response.json();
    const assets = json.peggedAssets || [];
    const sorted = assets
      .filter((s: any) => s.circulating?.peggedUSD > 0)
      .sort((a: any, b: any) => b.circulating.peggedUSD - a.circulating.peggedUSD);
    
    // Calculate total across all stablecoins
    const totalCirc = assets.reduce((sum: number, s: any) => sum + (s.circulating?.peggedUSD || 0), 0);
    
    const coins = sorted.slice(0, 5).map((s: any) => ({
      name: s.name,
      symbol: s.symbol,
      circulating: Math.round(s.circulating.peggedUSD),
    }));
    const total = totalCirc;
    const result = { total, top5: coins };
    setCached('stablecoins', result);
    res.json({ success: true, data: result });
  } catch (e: any) {
    res.json({ success: false, error: e.message });
  }
});


app.get('/api/crypto-news', async (req, res) => {
  try {
    const cached = getCached('cryptoNews');
    if (cached) return res.json({ success: true, data: cached });
    
    const response = await fetch('https://cointelegraph.com/rss', {
      signal: AbortSignal.timeout(10000),
      headers: { 'User-Agent': 'Mozilla/5.0' },
    });
    if (!response.ok) throw new Error('RSS failed');
    
    const xml = await response.text();
    // Simple RSS parsing - extract title, link, pubDate
    const items: { title: string; link: string; date: string }[] = [];

// Split into item blocks
const itemBlocks = xml.split("<item>").slice(1);

for (const block of itemBlocks) {
  if (items.length >= 10) break;
  const titleM = block.match(/<title>([^<]+)<\/title>/);
  const linkM = block.match(/<link>([^<]+)<\/link>/);
  const dateM = block.match(/<pubDate>([^<]+)<\/pubDate>/);
  if (titleM) {
    items.push({
      title: titleM[1].trim(),
      link: linkM ? linkM[1].trim() : "#",
      date: dateM ? new Date(dateM[1]).toLocaleDateString() : "",
    });
  }
}

setCached('cryptoNews', items);
    res.json({ success: true, data: items });
  } catch (e: any) {
    res.json({ success: false, error: e.message });
  }
});

