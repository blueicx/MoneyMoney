# ================================================
# PREDICT.FUN TRADING BOT CONFIGURATION
# ================================================

# Your API key from Predict.fun Discord
# Request via support ticket at https://discord.gg/predictdotfun
API_KEY=your_api_key_here

# Your wallet private key (WITHOUT 0x prefix)
# KEEP THIS SECRET! Never share or commit to git!
PRIVATE_KEY=your_private_key_here

# Network: "mainnet" or "testnet"
# Use testnet first to test your setup!
NETWORK=mainnet

# Dashboard binding: localhost is safest; use 0.0.0.0 only for phone/PWA LAN access.
APP_HOST=127.0.0.1
APP_PORT=3000
# Set true only when exposing the dashboard beyond localhost.
MONEYMONEY_LAN_MODE=false
# Required in LAN mode. Send as Authorization: Bearer <token>.
MONEYMONEY_ACCESS_TOKEN=

# Optional: Predict Account address (for smart wallet users)
# Leave empty if using regular EOA wallet
PREDICT_ACCOUNT=

# ================================================
# TRADING SETTINGS
# ================================================

# Default slippage for market orders (in basis points)
# 100 = 1%, 200 = 2%, etc.
DEFAULT_SLIPPAGE_BPS=200

# Order expiration time in seconds (default: 1 hour)
ORDER_EXPIRATION_SECONDS=3600

# --- Telegram Notifications (optional) ---
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Enable local getUpdates long polling for command replies.
TELEGRAM_POLLING_ENABLED=false
# Comma/space/newline-separated allowlist; blank falls back to TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional administrator allowlist for /audit; blank means the allowed Chat IDs are admins.
TELEGRAM_ADMIN_CHAT_IDS=

# --- WeCom / WeChat Work group robot (optional) ---
# Group -> Add Robot -> copy webhook
WECOM_WEBHOOK_URL=

# --- Bark iPhone push (optional) ---
# Install Bark, then copy the device key shown in the app.
BARK_DEVICE_KEY=

# --- Prediction title translation (optional) ---
# A contact email raises the free MyMemory quota; never commit a real address here.
MYMEMORY_EMAIL=

# --- Metaculus prediction radar (optional free account token) ---
METACULUS_API_TOKEN=

# --- Groq AI Analysis (free) ---
# Get free API key at https://console.groq.com
GROQ_API_KEY=
# Optional complete OpenAI-compatible endpoint; blank uses Groq's official endpoint.
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Optional legacy-style base URL; GROQ_API_URL has priority when both are set.
GROQ_BASE_URL=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter AI commentary (optional free-tier models) ---
OPENROUTER_API_KEY=
# Optional complete OpenAI-compatible endpoint; blank uses OpenRouter's official endpoint.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Existing base URL remains supported when OPENROUTER_API_URL is blank.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3:free

# --- Binance Portfolio Tracking (optional, READ-ONLY key recommended) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_PROXY_URL=

# AI paper runners are disabled by default; enable explicitly for simulation only.
AI_PAPER_TRADING_ENABLED=false
