{
  "name": "moneymoney",
  "version": "1.0.0",
  "description": "MoneyMoney Trading Bot - Simple and powerful trading on prediction markets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-web-assets.js",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.cjs",
    "dev": "ts-node src/index.ts",
    "trade": "ts-node src/index.ts",
    "live": "ts-node src/commands/dashboard.ts",
    "dashboard": "ts-node src/commands/dashboard.ts",
    "markets": "ts-node src/commands/markets.ts",
    "positions": "ts-node src/commands/positions.ts",
    "balance": "ts-node src/commands/balance.ts",
    "quick": "ts-node src/commands/quick-trade.ts",
    "example:trade": "ts-node src/examples/simple-trade.ts",
    "example:mm": "ts-node src/examples/market-maker.ts",
    "web": "ts-node src/web/server.ts",
    "analyze": "ts-node src/analysis/analyze.ts",
    "analyze:watch": "ts-node src/analysis/analyze.ts --watch",
    "security:scan": "node scripts/secret-scan.cjs",
    "smoke:web": "node scripts/web-smoke.cjs",
    "state:backup": "node scripts/state-backup.cjs",
    "state:restore": "node scripts/state-backup.cjs restore"
  },
  "keywords": [
    "predict.fun",
    "prediction-markets",
    "trading",
    "bnb",
    "crypto"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@predictdotfun/sdk": "^1.2.4",
    "better-sqlite3": "^12.11.1",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^5.2.1",
    "iconv-lite": "^0.6.3",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.5.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@yao-pkg/pkg": "^6.14.2",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "moneymoney-core": "dist/desktop-entry.js"
  },
  "pkg": {
    "assets": [
      "dist/web/public/**/*",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "targets": [
      "node24-win-x64"
    ],
    "outputPath": "release/core/MoneyMoneyCore.exe"
  }
}
